@inject PublicProjectCatalog ProjectCatalog
@inject PublicArticleCatalog ArticleCatalog

<header class="site-header" data-site-header>
    <div class="site-header-inner">
        <a class="wordmark" href="/" aria-label="Melrandia - Trang chủ">
            <img class="brand-avatar" src="/images/avatar.png" alt="" width="56" height="56" />
            <span class="wordmark-copy">
                <strong>Melrandia</strong>
                <span>Internet of Things</span>
                
            </span>
        </a>

        <nav class="desktop-nav" aria-label="Điều hướng chính">
            <NavLink href="/" Match="NavLinkMatch.All">Trang chủ</NavLink>
            <NavLink href="/gioi-thieu">Giới thiệu</NavLink>

            <div class="nav-dropdown" data-nav-dropdown>
                <span class="nav-dropdown-trigger">
                    <NavLink href="/du-an">Dự án</NavLink>
                    <button type="button" data-dropdown-toggle aria-expanded="false" aria-label="Mở danh sách dự án">
                        <i class="chevron" aria-hidden="true"></i>
                    </button>
                </span>
                <div class="nav-dropdown-menu project-dropdown" aria-label="Danh sách dự án">
                    @foreach (var project in PublicProjects)
                    {
                        <a href="@($"/du-an/{project.Slug}")"><span>@project.Sequence</span><strong>@project.DisplayName</strong><small>@project.Status</small></a>
                    }
                    <a class="dropdown-overview" href="/du-an">Xem tất cả dự án <span class="material-symbols-outlined" aria-hidden="true">arrow_right_alt</span></a>
                </div>
            </div>

            <div class="nav-dropdown" data-nav-dropdown>
                <span class="nav-dropdown-trigger">
                    <NavLink href="/bai-viet">Bài viết</NavLink>
                    <button type="button" data-dropdown-toggle aria-expanded="false" aria-label="Mở danh mục bài viết">
                        <i class="chevron" aria-hidden="true"></i>
                    </button>
                </span>
                <div class="nav-dropdown-menu article-dropdown" aria-label="Danh mục bài viết">
                    @foreach (var category in ArticleCategories)
                    {
                        <a href="@($"/bai-viet/{category.Slug}")"><span>@category.Sequence</span><strong>@category.DisplayName</strong><small>@category.PublishedCount bài viết</small></a>
                    }
                    <a class="dropdown-overview" href="/bai-viet">Xem tất cả bài viết <span class="material-symbols-outlined" aria-hidden="true">arrow_right_alt</span></a>
                </div>
            </div>

            <NavLink href="/lien-he">Liên hệ</NavLink>
        </nav>

        <div class="header-tools">
            <button class="theme-toggle" type="button" data-theme-toggle aria-label="Chuyển sang giao diện tối">
                <span class="theme-icon" aria-hidden="true">
                    <i class="sun-symbol">☀</i>
                    <i class="moon-symbol">☾</i>
                </span>
            </button>
            <span class="tool-divider" aria-hidden="true"></span>
            <div class="language-picker" data-language-picker>
                <button class="language-toggle" type="button" data-language-toggle aria-expanded="false" aria-label="Chọn ngôn ngữ">
                    <img class="language-flag" src="/images/languages/VI.svg" alt="" width="28" height="19" />
                    <span class="language-code">VI</span>
                    <i class="chevron" aria-hidden="true"></i>
                </button>
                <div class="language-menu" aria-label="Ngôn ngữ">
                    <button type="button" class="is-active" data-language-vi><img class="language-option-flag" src="/images/languages/VI.svg" alt="" width="26" height="17" /><span>Tiếng Việt</span><i aria-hidden="true">✓</i></button>
                    <button type="button" data-language-en><img class="language-option-flag" src="/images/languages/EN.svg" alt="" width="26" height="17" /><span>English</span><small>Sắp có</small></button>
                </div>
            </div>
            <span class="tool-divider" aria-hidden="true"></span>
            <AuthorizeView>
                <Authorized>
                    <a class="login-link" href="/Management"><span>Quản lý</span> <span class="material-symbols-outlined button-arrow" aria-hidden="true">arrow_right_alt</span></a>
                </Authorized>
                <NotAuthorized>
                    <a class="login-link" href="/login">Đăng nhập <span class="material-symbols-outlined button-arrow" aria-hidden="true">arrow_right_alt</span></a>
                </NotAuthorized>
            </AuthorizeView>
            <button class="mobile-menu-button" type="button" data-menu-toggle aria-expanded="false" aria-controls="mobile-navigation">
                <span class="sr-only">Mở menu</span><i class="material-symbols-outlined" aria-hidden="true">arrow_right_alt</i>
            </button>
        </div>
    </div>

    <nav id="mobile-navigation" class="mobile-nav" aria-label="Điều hướng trên điện thoại" data-mobile-nav>
        <NavLink href="/" Match="NavLinkMatch.All">Trang chủ</NavLink>
        <NavLink href="/gioi-thieu">Giới thiệu</NavLink>
        @* Project and article groups mirror the desktop dropdown on small screens. *@
        <div class="mobile-nav-group" data-mobile-nav-group>
            <span class="mobile-nav-group-trigger">
                <NavLink href="/du-an">Dự án</NavLink>
                <button type="button" data-mobile-nav-group-toggle aria-expanded="false" aria-label="Mở danh sách dự án"><i class="chevron" aria-hidden="true"></i></button>
            </span>
            <div class="mobile-nav-group-items">
                @foreach (var project in PublicProjects)
                {
                    <a href="@($"/du-an/{project.Slug}")"><span class="mobile-nav-item-sequence">@project.Sequence</span><span>@project.DisplayName</span></a>
                }
            </div>
        </div>
        <div class="mobile-nav-group" data-mobile-nav-group>
            <span class="mobile-nav-group-trigger">
                <NavLink href="/bai-viet">Bài viết</NavLink>
                <button type="button" data-mobile-nav-group-toggle aria-expanded="false" aria-label="Mở danh mục bài viết"><i class="chevron" aria-hidden="true"></i></button>
            </span>
            <div class="mobile-nav-group-items">
                @foreach (var category in ArticleCategories) { <a href="@($"/bai-viet/{category.Slug}")"><span class="mobile-nav-item-sequence">@category.Sequence</span><span>@category.DisplayName</span></a> }
            </div>
        </div>
        <NavLink href="/lien-he">Liên hệ</NavLink>
        <AuthorizeView>
            <Authorized><NavLink href="/Management">Quản lý</NavLink></Authorized>
            <NotAuthorized><NavLink href="/login">Đăng nhập</NavLink></NotAuthorized>
        </AuthorizeView>
    </nav>
</header>

@code {
    private IReadOnlyList<PublicProjectPreview> PublicProjects { get; set; } = [];
    private IReadOnlyList<PublicArticleCategory> ArticleCategories { get; set; } = [];

    protected override async Task OnInitializedAsync()
    {
        PublicProjects = await ProjectCatalog.GetPublishedProjectsAsync();
        ArticleCategories = await ArticleCatalog.GetCategoriesAsync();
    }
}
