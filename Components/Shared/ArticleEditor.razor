@using System.Security.Claims
@using Microsoft.AspNetCore.Http
@using Microsoft.AspNetCore.Components.Forms
@inject ArticleAdministrationService ArticlesService
@inject ArticleMarkdownRenderer MarkdownRenderer
@inject AuthenticationStateProvider AuthStateProvider
@inject IJSRuntime JS
@inject NavigationManager Navigation

@if (IsLoading)
{
    <div class="management-loading">Đang tải trình soạn thảo…</div>
}
else if (ArticleId is null || Article is not null)
{
<div class="post-editor-container">
    @if (SaveStatus == "saved")
    {
        <div class="form-notice success" data-article-save-success>Đã lưu thay đổi bài viết.</div>
    }
    @if (!string.IsNullOrWhiteSpace(ErrorNotice))
    {
        <div class="form-notice error" role="alert">@ErrorNotice</div>
    }
    else if (!string.IsNullOrWhiteSpace(SaveError))
    {
        <div class="form-notice error" role="alert">@SaveError</div>
    }
    <div class="post-editor-topbar">
        <div class="post-editor-header">
            <h1 class="post-editor-title">@(IsEditing ? "Chỉnh sửa bài viết" : "Thêm Bài viết")</h1>
            <p class="post-editor-subtitle">@(IsEditing ? "Cập nhật nội dung và thông tin xuất bản." : "Soạn nội dung và thiết lập thông tin xuất bản.")</p>
        </div>
        <div class="post-editor-mode-nav" role="group" aria-label="Chế độ soạn thảo bài viết">
            @if (IsEditing)
            {
                <a class="post-editor-mode-btn" href="/Management/Articles"><i class="bi bi-arrow-left"></i><span>Danh sách bài viết</span></a>
            }
            <button class="post-editor-mode-btn @(!PreviewMode ? "active" : "")" type="button" @onclick="() => PreviewMode = false">
                <i class="bi bi-pencil-square"></i>
                <span>Soạn thảo</span>
            </button>
            <button class="post-editor-mode-btn @(PreviewMode ? "active" : "")" type="button" @onclick="() => PreviewMode = true">
                <i class="bi bi-eye"></i>
                <span>Xem trước</span>
            </button>
        </div>
    </div>

    <form id="article-editor-form" class="portal-form" data-article-editor-form data-dirty="false" @onsubmit="OnPublishSubmitAsync">
        <div class="row g-4 align-items-start">
            <!-- Left Column: Title, Slug, Rich Text Markdown Editor, Summary (col-lg-8) -->
            <div class="col-lg-8">
                <!-- Card 1: Title Input -->
                <div class="post-editor-card">
                    <input class="post-editor-title-input" name="title" data-article-title minlength="5" maxlength="240" placeholder="Nhập tiêu đề bài viết..." required value="@Title" @oninput="OnTitleInput" />
                </div>

                <!-- Card 2: Friendly URL / Slug -->
                <div class="post-editor-card post-editor-slug-card">
                    <div class="post-editor-slug-lead">
                        <span class="post-editor-card-badge"><i class="bi bi-link-45deg"></i></span>
                        <span class="post-editor-slug-label">URL thân thiện:</span>
                        <span class="post-editor-slug-prefix">/bai-viet/</span>
                        <input class="post-editor-slug-input" name="slug" data-article-slug pattern="[a-z0-9-]+" maxlength="160" placeholder="tieu-de-bai-viet" required value="@Slug" @oninput="OnSlugInput" />
                    </div>
                    <button class="post-editor-copy-btn" type="button" data-article-copy-slug title="Sao chép liên kết bài viết" aria-label="Sao chép liên kết">
                        <i class="bi bi-copy"></i>
                    </button>
                </div>

                <!-- Card 3: Rich Text Editor & Toolbar -->
                <div class="post-editor-card post-editor-editor-card">
                    @if (!PreviewMode)
                    {
                        <!-- Toolbar -->
                        <div class="post-editor-toolbar" role="toolbar" aria-label="Định dạng Markdown">
                            <select class="post-editor-heading-select" aria-label="Chèn tiêu đề" data-article-heading="article-body">
                                <option value="">Đoạn văn</option>
                                <option value="h1">Tiêu đề 1 (H1)</option>
                                <option value="h2">Tiêu đề 2 (H2)</option>
                                <option value="h3">Tiêu đề 3 (H3)</option>
                                <option value="quote">Trích dẫn</option>
                            </select>
                            <div class="post-editor-divider"></div>
                            <button class="post-editor-btn fw-bold" type="button" title="In đậm (Bold)" data-article-format="bold" data-editor-target="article-body"><i class="bi bi-type-bold"></i></button>
                            <button class="post-editor-btn fst-italic" type="button" title="In nghiêng (Italic)" data-article-format="italic" data-editor-target="article-body"><i class="bi bi-type-italic"></i></button>
                            <div class="post-editor-divider"></div>
                            <button class="post-editor-btn" type="button" title="Chèn liên kết" data-article-format="link" data-editor-target="article-body"><i class="bi bi-link-45deg"></i></button>
                            <button class="post-editor-btn" type="button" title="Danh sách dấu chấm" data-article-format="unordered-list" data-editor-target="article-body"><i class="bi bi-list-ul"></i></button>
                            <button class="post-editor-btn" type="button" title="Danh sách có số" data-article-format="ordered-list" data-editor-target="article-body"><i class="bi bi-list-ol"></i></button>
                            <div class="post-editor-divider"></div>
                            <button class="post-editor-btn" type="button" title="Trích dẫn" data-article-format="quote" data-editor-target="article-body"><i class="bi bi-quote"></i></button>
                            <button class="post-editor-btn" type="button" title="Khối mã nguồn" data-article-format="code" data-editor-target="article-body"><i class="bi bi-code-slash"></i></button>
                            <button class="post-editor-btn" type="button" title="Chèn bảng" data-article-format="table" data-editor-target="article-body"><i class="bi bi-table"></i></button>
                            <button class="post-editor-btn" type="button" title="Chèn ảnh từ thư viện" @onclick="() => ShowPresets = !ShowPresets"><i class="bi bi-image"></i></button>
                        </div>
                        <textarea id="article-body" class="post-editor-textarea" name="contentMarkdown" rows="18" minlength="50" maxlength="200000" placeholder="Viết nội dung bài viết của bạn ở đây..." required @bind="ContentMarkdown" @bind:event="oninput"></textarea>
                    }
                    else
                    {
                        <article class="post-editor-preview">
                            @if (string.IsNullOrWhiteSpace(ContentMarkdown))
                            {
                                <div class="text-body-secondary fst-italic p-4 text-center">
                                    <i class="bi bi-file-earmark-text fs-1 d-block mb-2 text-muted"></i>
                                    Chưa có nội dung xem trước. Hãy nhập nội dung ở chế độ soạn thảo.
                                </div>
                            }
                            else if (PreviewHtml is not null)
                            {
                                <div class="article-markdown">@((MarkupString)PreviewHtml)</div>
                            }
                            else
                            {
                                <div class="post-editor-error">Nội dung có liên kết không an toàn; hãy sửa trước khi xem trước.</div>
                            }
                        </article>
                    }
                    <!-- Bottom Status Bar -->
                    <div class="post-editor-statusbar">
                        <span>Markdown</span>
                        <span>@WordCount từ · ~@ReadingTime phút đọc</span>
                    </div>
                </div>

                <!-- Card 4: Tóm tắt (meta description) -->
                <div class="post-editor-card">
                    <div class="post-editor-card-header">
                        <label class="post-editor-card-title">
                            <span>Tóm tắt (meta description)</span>
                            <span class="post-editor-card-help" title="Hiển thị trên thẻ tìm kiếm và trang danh sách bài viết"><i class="bi bi-question-circle"></i></span>
                        </label>
                        <small class="text-body-secondary font-monospace">@Summary.Length/700 ký tự</small>
                    </div>
                    <textarea class="form-control rounded-3 border" name="summary" minlength="20" maxlength="700" rows="3" placeholder="Nhập tóm tắt ngắn gọn về bài viết... (sẽ hiển thị ở trang danh sách và kết quả tìm kiếm)" required @bind="Summary" @bind:event="oninput"></textarea>
                </div>
            </div>

            <!-- Right Column: Cover Image, Category, Status, Publish Date, Actions (col-lg-4) -->
            <div class="col-lg-4">
                <!-- Card 1: Ảnh đại diện -->
                <div class="post-editor-card">
                    <div class="post-editor-card-header">
                        <div class="post-editor-card-title">
                            <span class="post-editor-card-badge"><i class="bi bi-image"></i></span>
                            <span>Ảnh đại diện</span>
                            <span class="post-editor-card-help" title="Ảnh tiêu đề chính của bài viết, tỉ lệ khuyến nghị 16:9"><i class="bi bi-question-circle"></i></span>
                        </div>
                        <button type="button" class="btn btn-sm btn-link text-decoration-none p-0 text-primary fw-semibold" @onclick="() => ShowPresets = !ShowPresets">
                            @(ShowPresets ? "Đóng mẫu" : "Mẫu có sẵn")
                        </button>
                    </div>

                    <!-- Presets Grid Picker (hidden by default) -->
                    <div id="article-image-presets" hidden="@(!ShowPresets)">
                        @if (!AvailableImages.Any())
                        {
                            <p class="small text-body-secondary mb-2">Chưa có ảnh trong hệ thống để chọn mẫu.</p>
                        }
                        else
                        {
                            <div class="post-editor-preset-grid">
                                @foreach (var article in AvailableImages)
                                {
                                    <div class="post-editor-preset-item" role="button" @onclick="() => SelectPresetCover(article.CoverUrl, article.Title)" title="Chọn làm ảnh bìa: @article.Title">
                                        <img src="@article.CoverUrl" alt="" loading="lazy" />
                                        <span>@article.Title</span>
                                    </div>
                                }
                            </div>
                        }
                    </div>

                    <!-- Click / Drag & Drop Upload Zone -->
                    <label for="cover-file-input" class="post-editor-dropzone" style="cursor: pointer;">
                        <div class="post-editor-dropzone-icon">
                            <i class="bi bi-cloud-arrow-up"></i>
                        </div>
                        <p class="fw-semibold text-primary mb-1 small">Nhấn để tải ảnh lên</p>
                        <p class="text-body-secondary mb-1" style="font-size: 11px;">Hoặc kéo thả ảnh vào đây</p>
                        <p class="text-muted mb-0" style="font-size: 10px;">(Tối ưu: 1200 x 630px, JPG/PNG/WebP, &lt; 8MB)</p>
                    </label>

                    <InputFile id="cover-file-input" OnChange="OnCoverFileSelected" accept="image/jpeg,image/png,image/gif,image/webp" hidden />

                    <!-- Image Preview Box -->
                    <div class="post-editor-preview-container" hidden="@(string.IsNullOrWhiteSpace(CoverPreviewUrl))">
                        <img src="@CoverPreviewUrl" alt="@(CoverAlt ?? "Ảnh đại diện xem trước")" class="post-editor-preview-img" />
                        <button class="post-editor-preview-clear" type="button" title="Bỏ ảnh đã chọn" aria-label="Bỏ ảnh đã chọn" @onclick="ClearCover">
                            <i class="bi bi-x-lg"></i>
                        </button>
                    </div>

                    <!-- Alt Text -->
                    <div class="mt-3">
                        <input class="form-control form-control-sm rounded-3" maxlength="300" placeholder="Mô tả nội dung ảnh đại diện (cho SEO)..." @bind="CoverAlt" />
                    </div>
                </div>

                <!-- Card 2: Danh mục -->
                <div class="post-editor-card">
                    <div class="post-editor-card-title mb-2">
                        <span class="post-editor-card-badge"><i class="bi bi-book"></i></span>
                        <span>Chuyên mục</span>
                    </div>
                    <div class="post-editor-select-wrap">
                        <select class="form-select rounded-3 post-editor-category-select" @bind="SelectedCategoryId" required>
                            <option value="" disabled selected="@(!SelectedCategoryId.HasValue)">Chọn chuyên mục...</option>
                            @foreach (var category in Snapshot.Categories.Where(category => category.IsEnabled || category.Id == SelectedCategoryId))
                            {
                                <option value="@category.Id">@category.DisplayName@(category.IsEnabled ? string.Empty : " (đã ẩn)")</option>
                            }
                        </select>
                        <i class="bi bi-chevron-down post-editor-select-arrow" aria-hidden="true"></i>
                    </div>
                </div>

                <!-- Card 3: Thẻ -->
                <div class="post-editor-card post-editor-tags-card">
                    <div class="post-editor-card-title mb-2">
                        <span class="post-editor-card-badge"><i class="bi bi-tags"></i></span>
                        <span>Thẻ</span>
                    </div>
                    <div class="post-editor-tagbox">
                        <div class="post-editor-tag-chips" aria-live="polite">
                            @foreach (var tag in TagList)
                            {
                                <span class="post-editor-tag-chip">
                                    <span>@tag</span>
                                    <button type="button" aria-label="Xóa thẻ @tag" @onclick="() => RemoveTag(tag)">
                                        <i class="bi bi-x"></i>
                                    </button>
                                </span>
                            }
                        </div>
                        <input class="post-editor-tag-input" type="text" maxlength="40" placeholder="Nhập thẻ rồi nhấn Enter..." aria-label="Nhập thẻ bài viết"
                               @bind="CurrentTagInput" @bind:event="oninput" @onkeydown="HandleTagKeyDown" />
                    </div>
                    <small class="text-body-secondary d-block mt-2">Tối đa 20 thẻ, mỗi thẻ không quá 40 ký tự.</small>
                </div>

                <!-- Card 4: Trạng thái -->
                <div class="post-editor-card">
                    <div class="post-editor-card-title mb-2">
                        <span class="post-editor-card-badge"><i class="bi bi-question-circle"></i></span>
                        <span>Trạng thái</span>
                    </div>
                    <div class="post-editor-radio-list">
                        <label class="post-editor-radio-item @(SelectedStatus == PortalArticleStatuses.Draft ? "is-selected" : "")">
                            <input class="post-editor-radio-input" type="radio" name="status" value="Draft" checked="@(SelectedStatus == PortalArticleStatuses.Draft)" @onchange='() => SelectedStatus = PortalArticleStatuses.Draft' />
                            <div class="post-editor-radio-body">
                                <p class="post-editor-radio-label">Nháp</p>
                                <p class="post-editor-radio-desc">Chỉ mình bạn có thể xem</p>
                            </div>
                        </label>
                        <label class="post-editor-radio-item @(SelectedStatus == PortalArticleStatuses.Published ? "is-selected" : "")">
                            <input class="post-editor-radio-input" type="radio" name="status" value="Published" checked="@(SelectedStatus == PortalArticleStatuses.Published)" @onchange='() => SelectedStatus = PortalArticleStatuses.Published' />
                            <div class="post-editor-radio-body">
                                <p class="post-editor-radio-label">Công khai</p>
                                <p class="post-editor-radio-desc">Mọi người có thể xem</p>
                            </div>
                        </label>
                        <label class="post-editor-radio-item @(SelectedStatus == PortalArticleStatuses.Scheduled ? "is-selected" : "")">
                            <input class="post-editor-radio-input" type="radio" name="status" value="Scheduled" checked="@(SelectedStatus == PortalArticleStatuses.Scheduled)" @onchange='() => SelectedStatus = PortalArticleStatuses.Scheduled' />
                            <div class="post-editor-radio-body">
                                <p class="post-editor-radio-label">Lên lịch</p>
                                <p class="post-editor-radio-desc">Tự động đăng vào thời gian đã chọn</p>
                            </div>
                        </label>
                        @if (IsEditing && SelectedStatus == PortalArticleStatuses.Archived)
                        {
                            <label class="post-editor-radio-item is-selected">
                                <input class="post-editor-radio-input" type="radio" name="status" value="Archived" checked @onchange='() => SelectedStatus = PortalArticleStatuses.Archived' />
                                <div class="post-editor-radio-body">
                                    <p class="post-editor-radio-label">Lưu trữ</p>
                                    <p class="post-editor-radio-desc">Không hiển thị công khai</p>
                                </div>
                            </label>
                        }
                    </div>
                </div>

                <!-- Card 5: Thời gian đăng / hẹn giờ -->
                <div class="post-editor-card">
                    <div class="post-editor-card-title mb-2">
                        <span class="post-editor-card-badge"><i class="bi bi-calendar-event"></i></span>
                        <span>Thời gian đăng (nếu có)</span>
                    </div>
                    <input class="form-control rounded-3 font-monospace" type="datetime-local" @bind="PublishedAtUtc" />
                    <small class="text-body-secondary d-block mt-1" style="font-size: 11px;">Bắt buộc khi chọn “Đã lên lịch” (giờ UTC).</small>
                </div>

                <!-- Card 6: Action Buttons -->
                <div class="post-editor-actions">
                    <button class="post-editor-btn-draft" type="button" disabled="@IsSaving" @onclick='() => SaveArticleAsync(PortalArticleStatuses.Draft)'>
                        @(IsSaving && TargetAction == PortalArticleStatuses.Draft ? "Đang lưu..." : "Lưu nháp")
                    </button>
                    <button class="post-editor-btn-publish" type="submit" disabled="@IsSaving">
                        <i class="bi @(IsEditing ? "bi-check2-circle" : "bi-send-fill")"></i>
                        <span>@(IsSaving && TargetAction != PortalArticleStatuses.Draft ? "Đang lưu..." : (IsEditing ? "Lưu thay đổi" : "Đăng bài"))</span>
                    </button>
                </div>
            </div>
        </div>
    </form>
</div>
<dialog class="article-leave-dialog" data-article-leave-dialog aria-labelledby="article-leave-title">
    <div class="article-leave-dialog-card">
        <span class="article-leave-dialog-icon"><i class="bi bi-file-earmark-text"></i></span>
        <h2 id="article-leave-title">Bạn có muốn lưu nháp bài viết này không?</h2>
        <p>Nội dung chưa lưu sẽ bị mất nếu bạn rời khỏi trang.</p>
        <div class="article-leave-dialog-actions">
            <button type="button" class="article-leave-save" data-article-leave-action="save">Lưu</button>
            <button type="button" class="article-leave-discard" data-article-leave-action="discard">Không lưu</button>
            <button type="button" class="article-leave-cancel" data-article-leave-action="cancel">Hủy bỏ</button>
        </div>
    </div>
</dialog>
}
else
{
    <div class="management-empty-state"><span class="bi bi-file-earmark-x" aria-hidden="true"></span><h3>Không tìm thấy bài viết</h3><p>Bài viết có thể đã bị xóa hoặc không còn khả dụng.</p><a class="management-secondary-action" href="/Management/Articles">Quay lại danh sách</a></div>
}

@code {
    [Parameter] public Guid? ArticleId { get; set; }
    [Parameter] public string? SaveStatus { get; set; }
    [Parameter] public string? SaveError { get; set; }

    private string Title { get; set; } = string.Empty;
    private string Slug { get; set; } = string.Empty;
    private string ContentMarkdown { get; set; } = string.Empty;
    private string Summary { get; set; } = string.Empty;
    private List<string> TagList { get; set; } = [];
    private string CurrentTagInput { get; set; } = string.Empty;
    private Guid? SelectedCategoryId { get; set; }
    private string SelectedStatus { get; set; } = PortalArticleStatuses.Draft;
    private DateTime? PublishedAtUtc { get; set; }

    // Cover image state
    private bool ShowPresets { get; set; }
    private string? CoverPreviewUrl { get; set; }
    private string? CoverAlt { get; set; }
    private byte[]? CoverBytes { get; set; }
    private string? CoverFileName { get; set; }
    private string? CoverContentType { get; set; }
    private string? PresetCoverUrl { get; set; }
    private bool IsExistingCoverRemoved { get; set; }

    private bool PreviewMode { get; set; }
    private ArticleAdminSnapshot Snapshot { get; set; } = new([], []);
    private ArticleAdminDetail? Article { get; set; }
    private bool IsLoading { get; set; } = true;
    private bool IsEditing => ArticleId.HasValue;
    private bool IsSaving { get; set; }
    private string? TargetAction { get; set; }
    private string? ErrorNotice { get; set; }
    private bool IsSlugManual { get; set; }

    private int WordCount => string.IsNullOrWhiteSpace(ContentMarkdown)
        ? 0
        : ContentMarkdown.Split((char[]?)null, StringSplitOptions.RemoveEmptyEntries).Length;

    private int ReadingTime => Math.Max(1, (WordCount + 199) / 200);

    private string? PreviewHtml
    {
        get
        {
            try { return MarkdownRenderer.Render(ContentMarkdown); }
            catch (InvalidOperationException) { return null; }
        }
    }

    private IEnumerable<ArticleAdminSummary> AvailableImages => Snapshot.Articles
        .Where(article => !string.IsNullOrWhiteSpace(article.CoverUrl))
        .GroupBy(article => article.CoverUrl, StringComparer.Ordinal)
        .Select(group => group.First())
        .Take(6);

    protected override async Task OnParametersSetAsync()
    {
        IsLoading = true;
        Snapshot = await ArticlesService.GetSnapshotAsync();
        Article = ArticleId.HasValue ? await ArticlesService.FindAsync(ArticleId.Value) : null;
        if (ArticleId.HasValue && Article is null)
        {
            IsLoading = false;
            return;
        }

        if (Article is not null)
        {
            Title = Article.Title;
            Slug = Article.Slug;
            Summary = Article.Summary;
            TagList = Article.Tags.Split(',', StringSplitOptions.TrimEntries | StringSplitOptions.RemoveEmptyEntries).ToList();
            ContentMarkdown = MarkdownRenderer.ToEditorMarkdown(Article.ContentMarkdown);
            SelectedCategoryId = Article.CategoryId;
            SelectedStatus = Article.Status;
            PublishedAtUtc = Article.PublishedAtUtc?.ToUniversalTime();
            CoverPreviewUrl = Article.Media.FirstOrDefault(m => m.IsCover)?.PublicUrl;
            CoverAlt = Article.Media.FirstOrDefault(m => m.IsCover)?.AltText ?? string.Empty;
            IsSlugManual = true;
        }
        else if (Snapshot.Categories.Count > 0 && !SelectedCategoryId.HasValue)
        {
            SelectedCategoryId = Snapshot.Categories.FirstOrDefault(c => c.IsEnabled)?.Id;
        }
        IsLoading = false;
    }

    private void OnTitleInput(ChangeEventArgs e)
    {
        Title = e.Value?.ToString() ?? string.Empty;
        if (!IsSlugManual && !IsEditing)
        {
            Slug = GenerateSlug(Title);
        }
    }

    private void OnSlugInput(ChangeEventArgs e)
    {
        Slug = e.Value?.ToString() ?? string.Empty;
        IsSlugManual = true;
    }

    private void AddTag()
    {
        var tag = CurrentTagInput.Trim().TrimStart('#');
        if (string.IsNullOrWhiteSpace(tag)) return;
        if (tag.Length > 40)
        {
            ErrorNotice = "Mỗi thẻ không được vượt quá 40 ký tự.";
            return;
        }
        if (TagList.Any(t => string.Equals(t, tag, StringComparison.OrdinalIgnoreCase)))
        {
            CurrentTagInput = string.Empty;
            return;
        }
        if (TagList.Count >= 20)
        {
            ErrorNotice = "Bài viết chỉ được có tối đa 20 thẻ.";
            return;
        }
        TagList.Add(tag);
        CurrentTagInput = string.Empty;
        ErrorNotice = null;
    }

    private void RemoveTag(string tag)
    {
        TagList.Remove(tag);
    }

    private void HandleTagKeyDown(KeyboardEventArgs e)
    {
        if (e.Key == "Enter")
        {
            AddTag();
        }
    }

    private async Task OnCoverFileSelected(InputFileChangeEventArgs e)
    {
        var file = e.File;
        if (file is null) return;
        try
        {
            if (file.Size > 8 * 1024 * 1024)
            {
                ErrorNotice = "Kích thước ảnh không được vượt quá 8MB.";
                return;
            }
            using var stream = file.OpenReadStream(maxAllowedSize: 10 * 1024 * 1024);
            using var ms = new MemoryStream();
            await stream.CopyToAsync(ms);
            CoverBytes = ms.ToArray();
            CoverFileName = file.Name;
            CoverContentType = file.ContentType;
            CoverPreviewUrl = $"data:{file.ContentType};base64,{Convert.ToBase64String(CoverBytes)}";
            IsExistingCoverRemoved = false;
            PresetCoverUrl = null;
            ErrorNotice = null;
        }
        catch (Exception ex)
        {
            ErrorNotice = $"Lỗi khi tải ảnh: {ex.Message}";
        }
    }

    private void SelectPresetCover(string? url, string? alt)
    {
        if (string.IsNullOrWhiteSpace(url)) return;
        PresetCoverUrl = url;
        CoverPreviewUrl = url;
        CoverBytes = null;
        CoverFileName = null;
        CoverContentType = null;
        IsExistingCoverRemoved = false;
        if (string.IsNullOrWhiteSpace(CoverAlt))
        {
            CoverAlt = alt ?? string.Empty;
        }
        ShowPresets = false;
    }

    private void ClearCover()
    {
        CoverBytes = null;
        CoverFileName = null;
        CoverContentType = null;
        PresetCoverUrl = null;
        CoverPreviewUrl = null;
        IsExistingCoverRemoved = true;
    }

    private Task OnPublishSubmitAsync()
    {
        var targetStatus = IsEditing
            ? SelectedStatus
            : (SelectedStatus == PortalArticleStatuses.Scheduled ? PortalArticleStatuses.Scheduled : PortalArticleStatuses.Published);
        return SaveArticleAsync(targetStatus);
    }

    private async Task SaveArticleAsync(string targetStatus)
    {
        if (IsSaving) return;

        var confirmMessage = targetStatus == PortalArticleStatuses.Draft
            ? "Bạn có chắc chắn muốn lưu bản nháp này?"
            : (IsEditing ? "Bạn có chắc chắn muốn cập nhật bài viết này?" : "Bạn có chắc chắn muốn đăng bài viết này?");

        var confirmed = await JS.InvokeAsync<bool>("confirm", confirmMessage);
        if (!confirmed) return;

        IsSaving = true;
        TargetAction = targetStatus;
        ErrorNotice = null;

        try
        {
            if (!SelectedCategoryId.HasValue || SelectedCategoryId == Guid.Empty)
            {
                ErrorNotice = "Vui lòng chọn chuyên mục cho bài viết.";
                return;
            }

            var authState = await AuthStateProvider.GetAuthenticationStateAsync();
            var user = authState.User;
            if (!Guid.TryParse(user.FindFirstValue(ClaimTypes.NameIdentifier), out var authorId))
            {
                ErrorNotice = "Không thể xác thực thông tin tài khoản đăng bài.";
                return;
            }
            var actor = user.Identity?.Name ?? "unknown";

            DateTime? publishedAt = targetStatus == PortalArticleStatuses.Scheduled
                ? (PublishedAtUtc.HasValue ? DateTime.SpecifyKind(PublishedAtUtc.Value, DateTimeKind.Utc) : null)
                : (targetStatus == PortalArticleStatuses.Published ? DateTime.UtcNow : null);

            var tagsJoined = string.Join(", ", TagList);
            var request = new SaveArticleRequest(
                ArticleId,
                SelectedCategoryId.Value,
                Slug,
                Title,
                Summary,
                tagsJoined,
                ContentMarkdown,
                targetStatus,
                publishedAt,
                CoverAlt ?? string.Empty,
                Article?.Version ?? 1,
                PresetCoverUrl: PresetCoverUrl,
                RemoveCover: IsExistingCoverRemoved
            );

            IReadOnlyList<IFormFile> coverFiles = [];
            if (CoverBytes != null && CoverBytes.Length > 0)
            {
                var ms = new MemoryStream(CoverBytes);
                var formFile = new FormFile(ms, 0, ms.Length, "cover", CoverFileName ?? "cover.jpg")
                {
                    Headers = new HeaderDictionary(),
                    ContentType = CoverContentType ?? "image/jpeg"
                };
                coverFiles = [formFile];
            }

            var savedId = await ArticlesService.SaveAsync(request, coverFiles, [], authorId, actor);

            // Mark form not dirty
            await JS.InvokeVoidAsync("eval", "document.querySelectorAll('[data-article-editor-form]').forEach(f => f.dataset.dirty = 'false');");

            if (IsEditing)
            {
                await JS.InvokeVoidAsync("showNotice", "Đã lưu thay đổi bài viết thành công.", 3000);
                Article = await ArticlesService.FindAsync(savedId);
                if (Article != null)
                {
                    Title = Article.Title;
                    Slug = Article.Slug;
                    Summary = Article.Summary;
                    TagList = Article.Tags.Split(',', StringSplitOptions.TrimEntries | StringSplitOptions.RemoveEmptyEntries).ToList();
                    ContentMarkdown = MarkdownRenderer.ToEditorMarkdown(Article.ContentMarkdown);
                    SelectedCategoryId = Article.CategoryId;
                    SelectedStatus = Article.Status;
                    PublishedAtUtc = Article.PublishedAtUtc?.ToUniversalTime();
                    CoverPreviewUrl = Article.Media.FirstOrDefault(m => m.IsCover)?.PublicUrl;
                    CoverAlt = Article.Media.FirstOrDefault(m => m.IsCover)?.AltText ?? string.Empty;
                    CoverBytes = null;
                    PresetCoverUrl = null;
                    IsExistingCoverRemoved = false;
                }
            }
            else
            {
                ArticleId = savedId;
                Navigation.NavigateTo($"/Management/Articles/Edit/{savedId}?status=saved");
            }
        }
        catch (Exception ex)
        {
            ErrorNotice = ex.Message;
        }
        finally
        {
            IsSaving = false;
            TargetAction = null;
        }
    }

    private static string GenerateSlug(string text)
    {
        if (string.IsNullOrWhiteSpace(text)) return string.Empty;
        var normalized = text.Normalize(System.Text.NormalizationForm.FormD);
        var sb = new System.Text.StringBuilder();
        foreach (var c in normalized)
        {
            var uc = System.Globalization.CharUnicodeInfo.GetUnicodeCategory(c);
            if (uc != System.Globalization.UnicodeCategory.NonSpacingMark)
            {
                if (c is 'đ' or 'Đ') sb.Append('d');
                else if (char.IsLetterOrDigit(c)) sb.Append(char.ToLowerInvariant(c));
                else if (c is ' ' or '-' or '_') sb.Append('-');
            }
        }
        var result = System.Text.RegularExpressions.Regex.Replace(sb.ToString(), "-+", "-").Trim('-');
        return result.Length > 160 ? result[..160] : result;
    }
