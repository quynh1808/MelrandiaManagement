@inherits LayoutComponentBase

<div class="management-shell">
    <aside class="management-sidebar">
        <div class="management-brand-row">
            <a class="management-brand" href="/Management">
                <img src="/images/avatar.png" alt="" width="44" height="44" />
                <span><strong>Melrandia</strong><small>Management Portal</small></span>
            </a>
            <button class="sidebar-toggle-btn" type="button" data-sidebar-toggle aria-label="Thu gọn hoặc mở rộng menu điều hướng" title="Thu gọn / Mở rộng menu">
                <svg viewBox="0 0 24 24" width="18" height="18" stroke="currentColor" stroke-width="2.2" fill="none" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true"><path d="M15 18l-6-6 6-6"/></svg>
            </button>
        </div>

        <nav class="management-nav" aria-label="Điều hướng quản trị">
            <span class="management-nav-label">Trung tâm quản lý</span>
            <NavLink href="/Management" Match="NavLinkMatch.All"><img class="management-nav-icon" src="/images/Managements/Overview.svg" alt="" aria-hidden="true" /><span>Tổng quan</span></NavLink>
            <NavLink href="/Management/Projects"><img class="management-nav-icon" src="/images/Managements/Projects.svg" alt="" aria-hidden="true" /><span>Dự án</span></NavLink>
            <NavLink href="/Management/Systems"><img class="management-nav-icon" src="/images/Managements/Services.svg" alt="" aria-hidden="true" /><span>Kết nối</span></NavLink>
            <NavLink href="/Management/Tasks"><img class="management-nav-icon" src="/images/Managements/Tasks.svg" alt="" aria-hidden="true" /><span>Nhiệm vụ</span></NavLink>
            <NavLink href="/Management/Alerts"><img class="management-nav-icon" src="/images/Managements/Notifications.svg" alt="" aria-hidden="true" /><span>Thông báo</span></NavLink>
            <NavLink href="/Management/Reports"><img class="management-nav-icon" src="/images/Managements/Reports.svg" alt="" aria-hidden="true" /><span>Báo cáo</span></NavLink>
            <NavLink href="/Management/Integrations"><img class="management-nav-icon" src="/images/Managements/Intergrations.svg" alt="" aria-hidden="true" /><span>Tích hợp</span></NavLink>
            <span class="management-nav-label management-nav-group">Nội dung</span>
            <NavLink href="/Management/Articles" Match="NavLinkMatch.All"><img class="management-nav-icon" src="/images/Managements/Article.svg" alt="" aria-hidden="true" /><span>Bài viết</span></NavLink>
            <NavLink href="/Management/Articles/New"><img class="management-nav-icon" src="/images/Managements/AddArticles.svg" alt="" aria-hidden="true" /><span>Thêm bài viết</span></NavLink>
            <span class="management-nav-label management-nav-group">Quản trị</span>
            <NavLink href="/Management/Users"><img class="management-nav-icon" src="/images/Managements/User.svg" alt="" aria-hidden="true" /><span>Tài khoản</span></NavLink>
            <!-- <NavLink href="/Management/Access"><i>♧</i><span>Quyền dự án</span></NavLink> -->
            <NavLink href="/Management/Settings"><img class="management-nav-icon" src="/images/Managements/Settings.svg" alt="" aria-hidden="true" /><span>Thiết lập</span></NavLink>
        </nav>
        <a class="management-public-link" href="/"><span class="material-symbols-outlined management-public-arrow" aria-hidden="true">arrow_left_alt</span><span>Trang web công khai</span></a>
    </aside>

    <div class="management-workspace">
        <header class="management-topbar">
            <label class="management-search">
                <span aria-hidden="true">⌕</span>
                <input type="search" placeholder="Tìm dự án trên trang hiện tại…" data-management-search />
            </label>
            <div class="management-top-actions">
                <button class="theme-toggle management-theme-toggle" type="button" data-theme-toggle aria-label="Chuyển giao diện">
                    <span class="theme-icon" aria-hidden="true"><i class="sun-symbol">☀</i><i class="moon-symbol">☾</i></span>
                </button>
                <AuthorizeView>
                    <Authorized Context="auth">
                        <details class="management-account-menu">
                            <summary aria-label="Mở menu tài khoản">
                                <span class="management-user-avatar">@Initials(auth.User.Identity?.Name)</span>
                                <span class="management-account-copy"><strong>@auth.User.Identity?.Name</strong><small>Administrator</small></span>
                                <svg class="management-account-chevron" viewBox="0 0 16 16" width="14" height="14" aria-hidden="true">
                                    <path d="M4 6l4 4 4-4" stroke="currentColor" stroke-width="1.75" stroke-linecap="round" stroke-linejoin="round" fill="none" />
                                </svg>
                            </summary>
                            <div class="management-account-dropdown">
                                <div><strong>@auth.User.Identity?.Name</strong><small>Quản trị viên Melrandia</small></div>
                                <a href="/Management/Users">Quản lý tài khoản</a>
                                <a href="/Management/Settings">Thiết lập hệ thống</a>
                                <a href="/">Trang web công khai</a>
                                <form method="post" action="/auth/logout" onsubmit="return confirm('Bạn có chắc chắn muốn đăng xuất?');">
                                    <AntiforgeryToken />
                                    <button type="submit">Đăng xuất</button>
                                </form>
                            </div>
                        </details>
                    </Authorized>
                </AuthorizeView>
            </div>
        </header>

        <main class="management-main">
            @Body
        </main>
    </div>
</div>

@code {
    private static string Initials(string? name)
    {
        if (string.IsNullOrWhiteSpace(name)) return "AD";
        return name.Trim()[..Math.Min(2, name.Trim().Length)].ToUpperInvariant();
    }
}
