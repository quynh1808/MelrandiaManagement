@page "/Management/Projects"
@attribute [Authorize(Policy = "ManagePortal")]
@layout ManagementLayout
@inject PortalAdministrationService Administration

<PageTitle>Quản lý dự án · Melrandia</PageTitle>

<section class="management-page-heading compact">
    <div><h1>Dự án</h1><p>Quản lý và giám sát toàn bộ project trong Melrandia.</p></div>
    <button class="management-primary-action" type="button" data-project-modal-open>＋ Thêm dự án</button>
</section>

@if (!string.IsNullOrWhiteSpace(Status)) { <div class="form-notice success">Đã lưu thay đổi Project Registry.</div> }
@if (!string.IsNullOrWhiteSpace(Error)) { <div class="form-notice error">@Error</div> }

<section class="management-kpi-grid">
    <article><span class="kpi-icon blue">▱</span><div><small>Tổng số Projects</small><strong>@Projects.Count</strong><em class="kpi-active-status"><span class="active-dot-pulsing">⦁</span> <span class="active-count">@Projects.Count(x => x.LifecycleStatus == "Active")</span> <span class="active-label">Đang hoạt động</span></em></div></article>
    <article><span class="kpi-icon green">●</span><div><small>Đang hoạt động</small><strong>@Projects.Count(x => x.LifecycleStatus == "Active")</strong><em>Đang vận hành</em></div></article>
    <article><span class="kpi-icon orange">◴</span><div><small>Đang thực hiện</small><strong>@Projects.Count(x => x.LifecycleStatus == "Planned")</strong><em>Đang chuẩn bị</em></div></article>
    <article><span class="kpi-icon violet">✓</span><div><small>Trạng thái</small><strong>@Projects.Count(x => x.HealthStatus == "Healthy")</strong><em>Health thành công</em></div></article>
</section>

<dialog class="project-modal" data-project-modal aria-labelledby="new-project-title">
    <div class="project-modal-card">
        <header class="project-modal-header">
            <div><h2 id="new-project-title">Thêm dự án</h2><p>Mỗi record đại diện cho một hệ thống triển khai độc lập.</p></div>
            <button class="project-modal-close" type="button" data-project-modal-close aria-label="Đóng cửa sổ">×</button>
        </header>
        <form class="portal-form" method="post" action="/management/projects/save" onsubmit="return confirm('Bạn có chắc chắn muốn thêm dự án này?');">
            <AntiforgeryToken />
            <div class="form-grid two">
                <label><span>Project key</span><input name="projectKey" placeholder="ams" pattern="[a-z0-9-]+" required /></label>
                <label><span>Slug công khai</span><input name="slug" placeholder="ams" pattern="[a-z0-9-]+" required /></label>
                <label><span>Tên viết tắt</span><input name="shortName" placeholder="AMS" maxlength="20" required /></label>
                <label><span>Thứ tự</span><input name="displayOrder" type="number" min="0" max="9999" value="10" required /></label>
            </div>
            <label><span>Tên dự án</span><input name="displayName" placeholder="Aquaculture Monitoring System" required /></label>
            <label><span>Mô tả</span><textarea name="description" rows="3" required></textarea></label>
            <label><span>Public URL</span><input name="publicUrl" type="url" placeholder="http://192.168.100.66:8081" /></label>
            <label><span>Health URL</span><input name="healthUrl" type="url" placeholder="http://aquaops:8080/health/ready" /></label>
            <label><span>Vòng đời</span><select name="lifecycleStatus"><option>Planned</option><option>Active</option><option>Maintenance</option><option>Retired</option></select></label>
            <div class="checkbox-row">
                <label><input type="checkbox" name="isEnabled" /> Theo dõi health</label>
                <label><input type="checkbox" name="isPublic" checked /> Hiển thị công khai</label>
                <label><input type="checkbox" name="isFeatured" /> Dự án nổi bật</label>
            </div>
            <button class="management-primary-action" type="submit">＋ Thêm dự án</button>
        </form>
    </div>
</dialog>

<div class="management-two-column project-registry-layout">
    <section class="management-panel registry-list-panel">
        <header class="panel-toolbar"><div><h2>Danh sách dự án</h2><p>@Projects.Count dự án đã đăng ký.</p></div><label class="compact-select"><select data-management-status-filter aria-label="Lọc trạng thái"><option value="all">All status</option><option value="healthy">Online</option><option value="unavailable">Offline</option><option value="unknown">Unknown</option></select></label></header>
        <div class="management-table-wrap project-table-wrap">
            <table class="management-table project-status-table">
                <thead>
                    <tr><th>Dự án</th><th>Trạng thái</th><th>Nhãn</th><th>Dịch vụ</th><th>Tiến trình</th><th>Thời gian hoạt động</th><th>Thời gian phản hồi</th><th>Thao tác</th></tr>
                </thead>
                <tbody>
            @foreach (var project in Projects)
            {
                var statusClass = HealthClass(project.HealthStatus);
                <tr data-status="@statusClass" data-search-item="@($"{project.ShortName} {project.DisplayName} {project.ProjectKey}")">
                    <td><strong>@project.DisplayName</strong><small>@project.ProjectKey</small></td>
                    <td><span class="health-pill @statusClass"><i></i>@HealthText(project.HealthStatus)</span><small>@project.HealthUrl</small></td>
                    <td><span class="project-label">Thủy sản</span></td>
                    <td><strong>8</strong></td>
                    <td><div class="project-progress"><span style="width: 100%"></span></div><strong>100%</strong></td>
                    <td>3d20p</td>
                    <td>@(project.LastResponseMilliseconds.HasValue ? $"{project.LastResponseMilliseconds}ms" : "10ms")</td>
                    <td>
                        <div class="project-row-actions">
                            @if (!string.IsNullOrWhiteSpace(project.PublicUrl)){<a class="project-access-link has-arrow" href="@project.PublicUrl" target="_blank" rel="noopener noreferrer"><span class="project-access-label">Truy cập dự án</span><span class="material-symbols-outlined project-access-arrow" aria-hidden="true">arrow_right_alt</span></a>}else{<span class="project-access-unavailable">Chưa khả dụng</span>}
                            <details class="project-actions-menu">
                                <summary aria-label="Mở thao tác dự án">⋮</summary>
                                <div><button type="button">Chỉnh sửa dự án</button></div>
                            </details>
                        </div>
                    </td>
                </tr>
            }
                </tbody>
            </table>
        </div>
    </section>
</div>

@code {
    [SupplyParameterFromQuery(Name = "status")] public string? Status { get; set; }
    [SupplyParameterFromQuery(Name = "error")] public string? Error { get; set; }
    private IReadOnlyList<ManagementProjectCard> Projects { get; set; } = [];
    protected override async Task OnInitializedAsync() => Projects = await Administration.GetProjectsAsync();
    private static string ProjectColor(int order) => (order % 4) switch { 0 => "orange", 1 => "blue", 2 => "green", _ => "violet" };
    private static string HealthClass(string status) => status switch { "Healthy" => "healthy", "Unavailable" => "unavailable", _ => "unknown" };
    private static string HealthText(string status) => status switch { "Healthy" => "Đang hoạt động", "Unavailable" => "Đang tắt", _ => "Chưa kiểm tra" };
}
