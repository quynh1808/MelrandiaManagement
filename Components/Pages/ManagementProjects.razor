@page "/Management/Projects"
@attribute [Authorize(Policy = "ManagePortal")]
@layout ManagementLayout
@inject PortalAdministrationService Administration

<PageTitle>Quản lý dự án · Melrandia</PageTitle>

<section class="management-page-heading compact">
    <div><h1>Dự án</h1><p>Quản lý và giám sát toàn bộ project trong Melrandia.</p></div>
    <a class="management-primary-action" href="#new-project">＋ Thêm dự án</a>
</section>

@if (!string.IsNullOrWhiteSpace(Status)) { <div class="form-notice success">Đã lưu thay đổi Project Registry.</div> }
@if (!string.IsNullOrWhiteSpace(Error)) { <div class="form-notice error">@Error</div> }

<section class="management-kpi-grid">
    <article><span class="kpi-icon blue">▱</span><div><small>Tổng dự án</small><strong>@Projects.Count</strong><em>Project Registry</em></div></article>
    <article><span class="kpi-icon green">●</span><div><small>Active</small><strong>@Projects.Count(x => x.LifecycleStatus == "Active")</strong><em>Đang vận hành</em></div></article>
    <article><span class="kpi-icon orange">◴</span><div><small>In progress</small><strong>@Projects.Count(x => x.LifecycleStatus == "Planned")</strong><em>Đang chuẩn bị</em></div></article>
    <article><span class="kpi-icon violet">✓</span><div><small>Healthy</small><strong>@Projects.Count(x => x.HealthStatus == "Healthy")</strong><em>Health thành công</em></div></article>
</section>

<div class="management-two-column project-registry-layout">
    <section id="new-project" class="management-panel management-form-panel">
        <header><div><h2>Thêm dự án</h2><p>Mỗi record đại diện cho một hệ thống triển khai độc lập.</p></div></header>
        <form class="portal-form" method="post" action="/management/projects/save" onsubmit="return confirm('Bạn có chắc chắn muốn thêm dự án này?');">
            <AntiforgeryToken />
            <div class="form-grid two">
                <label><span>Project key</span><input name="projectKey" placeholder="ams" pattern="[a-z0-9-]+" required /></label>
                <label><span>Slug công khai</span><input name="slug" placeholder="ams" pattern="[a-z0-9-]+" required /></label>
                <label><span>Tên viết tắt</span><input name="shortName" placeholder="AMS" maxlength="20" required /></label>
                <label><span>Thứ tự</span><input name="displayOrder" type="number" min="0" max="9999" value="10" required /></label>
            </div>
            <label><span>Tên dự án</span><input name="displayName" placeholder="Aquaculture Monitoring System" required /></label>
            <label><span>Mô tả</span><textarea name="description" rows="3" required></textarea></label>
            <label><span>Public URL</span><input name="publicUrl" type="url" placeholder="http://192.168.100.66:8081" /></label>
            <label><span>Health URL</span><input name="healthUrl" type="url" placeholder="http://aquaops:8080/health/ready" /></label>
            <label><span>Vòng đời</span><select name="lifecycleStatus"><option>Planned</option><option>Active</option><option>Maintenance</option><option>Retired</option></select></label>
            <div class="checkbox-row">
                <label><input type="checkbox" name="isEnabled" /> Theo dõi health</label>
                <label><input type="checkbox" name="isPublic" checked /> Hiển thị công khai</label>
                <label><input type="checkbox" name="isFeatured" /> Dự án nổi bật</label>
            </div>
            <button class="management-primary-action" type="submit">＋ Thêm dự án</button>
        </form>
    </section>

    <section class="management-panel registry-list-panel">
        <header class="panel-toolbar"><div><h2>Registry hiện tại</h2><p>@Projects.Count project đã đăng ký.</p></div><label class="compact-select"><select data-management-status-filter aria-label="Lọc trạng thái"><option value="all">All status</option><option value="healthy">Online</option><option value="unavailable">Offline</option><option value="unknown">Unknown</option></select></label></header>
        <div class="registry-edit-list">
            @foreach (var project in Projects)
            {
                <details id="project-@project.Id" data-status="@HealthClass(project.HealthStatus)" data-search-item="@($"{project.ShortName} {project.DisplayName} {project.ProjectKey}")">
                    <summary>
                        <span class="project-monogram @ProjectColor(project.DisplayOrder)">@project.ShortName</span>
                        <span><strong>@project.DisplayName</strong><small>@project.ProjectKey · @project.LifecycleStatus</small></span>
                        <span class="health-pill @HealthClass(project.HealthStatus)"><i></i>@project.HealthStatus</span>
                    </summary>
                    <form class="portal-form compact-form" method="post" action="/management/projects/save" onsubmit="return confirm('Bạn có chắc chắn muốn cập nhật dự án này?');">
                        <AntiforgeryToken /><input type="hidden" name="id" value="@project.Id" />
                        <div class="form-grid two">
                            <label><span>Project key</span><input name="projectKey" value="@project.ProjectKey" required /></label>
                            <label><span>Slug</span><input name="slug" value="@project.Slug" required /></label>
                            <label><span>Tên viết tắt</span><input name="shortName" value="@project.ShortName" required /></label>
                            <label><span>Thứ tự</span><input name="displayOrder" type="number" value="@project.DisplayOrder" min="0" max="9999" /></label>
                        </div>
                        <label><span>Tên dự án</span><input name="displayName" value="@project.DisplayName" required /></label>
                        <label><span>Mô tả</span><textarea name="description" rows="3">@project.Description</textarea></label>
                        <label><span>Public URL</span><input name="publicUrl" type="url" value="@project.PublicUrl" /></label>
                        <label><span>Health URL</span><input name="healthUrl" type="url" value="@project.HealthUrl" /></label>
                        <label><span>Vòng đời</span><input name="lifecycleStatus" value="@project.LifecycleStatus" required /></label>
                        <div class="checkbox-row">
                            <label><input type="checkbox" name="isEnabled" checked="@project.IsEnabled" /> Theo dõi health</label>
                            <label><input type="checkbox" name="isPublic" checked="@project.IsPublic" /> Công khai</label>
                            <label><input type="checkbox" name="isFeatured" checked="@project.IsFeatured" /> Nổi bật</label>
                        </div>
                        <button class="management-secondary-action" type="submit">Lưu thay đổi</button>
                    </form>
                </details>
            }
        </div>
    </section>
</div>

@code {
    [SupplyParameterFromQuery(Name = "status")] public string? Status { get; set; }
    [SupplyParameterFromQuery(Name = "error")] public string? Error { get; set; }
    private IReadOnlyList<ManagementProjectCard> Projects { get; set; } = [];
    protected override async Task OnInitializedAsync() => Projects = await Administration.GetProjectsAsync();
    private static string ProjectColor(int order) => (order % 4) switch { 0 => "orange", 1 => "blue", 2 => "green", _ => "violet" };
    private static string HealthClass(string status) => status switch { "Healthy" => "healthy", "Unavailable" => "unavailable", _ => "unknown" };
}
