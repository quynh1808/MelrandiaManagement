@page "/login"

<PageTitle>Đăng nhập · Melrandia</PageTitle>

<section class="simple-page login-preview-page">
    <div>
        <span class="page-kicker">Khu vực quản trị</span>
        <h1>Đăng nhập Melrandia.</h1>
        <p>Chức năng xác thực và Bảng điều khiển quản trị sẽ được triển khai sau khi giao diện công khai được nghiệm thu.</p>
    </div>
    <div class="login-preview-card" aria-label="Bản xem trước biểu mẫu đăng nhập">
        <label>Tài khoản<input type="text" disabled placeholder="Chưa khả dụng" /></label>
        <label>Mật khẩu<input type="password" disabled placeholder="••••••••••••" /></label>
        <button class="button button-primary" type="button" disabled>Đăng nhập</button>
        <small>Chức năng đang được chuẩn bị.</small>
    </div>
</section>
