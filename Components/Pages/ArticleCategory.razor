@page "/bai-viet/{Slug}"
@inject PublicArticleCatalog ArticleCatalog

@if (Category is null)
{
    <PageTitle>Không tìm thấy chuyên mục · Melrandia</PageTitle>
    <section class="simple-page status-page">
        <span class="page-kicker">Bài viết</span>
        <h1>Không tìm thấy chuyên mục.</h1>
        <a class="text-link" href="/bai-viet">Xem danh mục bài viết →</a>
    </section>
}
else
{
    <PageTitle>@Category.DisplayName · Melrandia</PageTitle>
    <section class="simple-page article-category-page">
        <span class="page-kicker">@Category.Sequence · Chuyên mục</span>
        <h1>@Category.DisplayName</h1>
        <p>@Category.Summary</p>
        <div class="detail-note">Chưa có bài viết được xuất bản trong chuyên mục này. URL đã sẵn sàng để giữ điều hướng ổn định khi hệ thống quản trị nội dung được bổ sung.</div>
        <a class="text-link" href="/bai-viet">Trở về danh mục bài viết →</a>
    </section>
}

@code {
    [Parameter]
    public string Slug { get; set; } = string.Empty;

    private PublicArticleCategory? Category { get; set; }

    protected override void OnParametersSet() => Category = ArticleCatalog.FindBySlug(Slug);
}
