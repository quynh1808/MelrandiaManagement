@page "/bai-viet/{CategorySlug}/{ArticleSlug}"
@inject PublicArticleCatalog ArticleCatalog

@if (Article is null)
{
    <PageTitle>Không tìm thấy bài viết · Melrandia</PageTitle>
    <section class="simple-page status-page"><span class="page-kicker">Bài viết</span><h1>Bài viết không tồn tại hoặc chưa được xuất bản.</h1><a class="text-link" href="/bai-viet">Xem các bài viết khác →</a></section>
}
else
{
    <PageTitle>@Article.Title · Melrandia</PageTitle>
    <article class="public-article-detail">
        <header><a href="@($"/bai-viet/{Article.CategorySlug}")">@Article.CategoryName</a><h1>@Article.Title</h1><p>@Article.Summary</p><div><span>@Article.AuthorName</span><time datetime="@Article.PublishedAtUtc.ToString("O")">@Article.PublishedAtUtc.ToLocalTime().ToString("dd/MM/yyyy HH:mm")</time></div></header>
        @if (!string.IsNullOrWhiteSpace(Article.CoverUrl)) { <img class="article-detail-cover" src="@Article.CoverUrl" alt="@Article.CoverAlt" /> }
        <section class="article-markdown">@((MarkupString)Article.ContentHtml)</section>
        @if (Article.Gallery.Count > 0) { <section class="article-gallery" aria-label="Hình ảnh bài viết">@foreach (var media in Article.Gallery){<figure><img src="@media.PublicUrl" alt="@media.AltText" loading="lazy" />@if (!string.IsNullOrWhiteSpace(media.Caption)){<figcaption>@media.Caption</figcaption>}</figure>}</section> }
        <footer><a class="text-link" href="@($"/bai-viet/{Article.CategorySlug}")">← Xem thêm trong @Article.CategoryName</a></footer>
    </article>
}

@code {
    [Parameter] public string CategorySlug { get; set; } = string.Empty;
    [Parameter] public string ArticleSlug { get; set; } = string.Empty;
    private PublicArticleDetail? Article { get; set; }
    protected override async Task OnParametersSetAsync() => Article = await ArticleCatalog.FindPublishedArticleAsync(CategorySlug, ArticleSlug);
}
