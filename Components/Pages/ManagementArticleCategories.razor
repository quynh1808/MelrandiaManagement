@page "/Management/Articles/Categories"
@attribute [Authorize(Policy = "ManagePortal")]
@layout ManagementLayout
@inject ArticleAdministrationService ArticlesService
@inject AuthenticationStateProvider AuthStateProvider
@inject IJSRuntime JS
@using System.Security.Claims

<PageTitle>Chuyên mục · Melrandia</PageTitle>

<section class="management-page-heading compact">
    <div><h1>Chủ đề &amp; Danh mục</h1><p>Phân loại nội dung và quản lý các chủ đề của blog.</p></div>
    <button class="management-primary-action" type="button" @onclick="OpenCreateModal"><i class="bi bi-plus-lg" aria-hidden="true"></i> Thêm chủ đề mới</button>
</section>

@if (!string.IsNullOrWhiteSpace(SuccessNotice)) { <div class="form-notice success">@SuccessNotice</div> }
else if (Status == "created") { <div class="form-notice success">Đã tạo chuyên mục.</div> }
else if (Status == "updated") { <div class="form-notice success">Đã cập nhật chuyên mục.</div> }
else if (Status == "enabled") { <div class="form-notice success">Chuyên mục đã được hiển thị công khai.</div> }
else if (Status == "disabled") { <div class="form-notice success">Chuyên mục đã được ẩn khỏi website công khai.</div> }
else if (Status == "deleted") { <div class="form-notice success">Đã xóa chuyên mục.</div> }
@if (!string.IsNullOrWhiteSpace(ErrorNotice)) { <div class="form-notice error">@ErrorNotice</div> }
else if (!string.IsNullOrWhiteSpace(Error)) { <div class="form-notice error">@Error</div> }
@if (!string.IsNullOrWhiteSpace(LoadError)) { <div class="form-notice error">@LoadError</div> }

<section class="management-kpi-grid category-kpi-grid" aria-label="Thống kê chuyên mục">
    <article><span class="kpi-icon blue"><i class="bi bi-collection" aria-hidden="true"></i></span><div><small>Tổng chủ đề</small><strong>@Categories.Count</strong><em>Đã đăng ký</em></div></article>
    <article><span class="kpi-icon green"><i class="bi bi-globe2" aria-hidden="true"></i></span><div><small>Đang công khai</small><strong>@Categories.Count(x => x.IsEnabled)</strong><em>Hiển thị trên website</em></div></article>
    <article><span class="kpi-icon violet"><i class="bi bi-journal-text" aria-hidden="true"></i></span><div><small>Bài viết đã xuất bản</small><strong>@Categories.Sum(x => x.PublishedArticleCount)</strong><em>Trong các chủ đề</em></div></article>
</section>

<dialog class="project-modal category-modal" data-category-modal data-open-on-load="@(ShowForm ? "true" : "false")" aria-labelledby="category-modal-title">
    <div class="project-modal-card">
        <header class="project-modal-header">
            <div><h2 id="category-modal-title">@(EditId.HasValue ? "Chỉnh sửa chuyên mục" : "Thêm chủ đề mới")</h2><p>Thông tin này được sử dụng trên trang bài viết công khai.</p></div>
            <button class="project-modal-close" type="button" @onclick="CloseModal" aria-label="Đóng cửa sổ">×</button>
        </header>
        @if (!string.IsNullOrWhiteSpace(ModalError))
        {
            <div class="form-notice error mt-3" role="alert">@ModalError</div>
        }
        <form class="portal-form category-form" @onsubmit="SaveCategoryAsync">
            <div class="form-grid two">
                <label><span>Tên chủ đề</span><input name="displayName" data-category-name maxlength="120" placeholder="Ví dụ: Khoa học vũ trụ" required @bind="FormDisplayName" @bind:event="oninput" /></label>
                <label><span>Slug URL</span><input name="slug" data-category-slug pattern="[a-z0-9]+(?:-[a-z0-9]+)*" maxlength="80" placeholder="khoa-hoc-vu-tru" required @bind="FormSlug" @bind:event="oninput" /><small class="field-help">Đổi slug sẽ làm thay đổi đường dẫn công khai của chủ đề và bài viết.</small></label>
            </div>
            <label><span>Mô tả</span><textarea name="summary" rows="3" maxlength="500" placeholder="Mô tả ngắn về chủ đề này..." required @bind="FormSummary"></textarea></label>
            <div class="form-grid two category-form-options">
                <label><span>Thứ tự hiển thị</span><input type="number" name="displayOrder" min="0" max="9999" required @bind="FormDisplayOrder" /><small class="field-help">Số nhỏ hơn sẽ xuất hiện trước.</small></label>
                <label class="single-checkbox"><input type="checkbox" name="isEnabled" @bind="FormIsEnabled" /> Hiển thị trên website công khai</label>
            </div>
            <div class="category-form-actions">
                <button class="management-primary-action" type="submit" disabled="@IsProcessing">@(EditId.HasValue ? "Lưu thay đổi" : "Tạo chủ đề")</button>
                <button class="management-secondary-action" type="button" @onclick="CloseModal">Hủy</button>
            </div>
        </form>
    </div>
</dialog>

<section class="management-panel category-list-panel">
    <header class="panel-toolbar">
        <div><h2>Danh mục chủ đề</h2><p>@Categories.Count chủ đề đã đăng ký.</p></div>
        <label class="compact-select"><select data-management-status-filter aria-label="Lọc chuyên mục"><option value="all">Tất cả chuyên mục</option><option value="enabled">Đang công khai</option><option value="disabled">Đang ẩn</option></select></label>
    </header>
    @if (Categories.Count == 0)
    {
        <div class="management-empty-state compact"><span class="material-symbols-outlined" aria-hidden="true">category</span><h3>Chưa có chuyên mục</h3><p>Tạo chủ đề đầu tiên để phân loại bài viết.</p></div>
    }
    else
    {
        <div class="category-card-grid">
            @foreach (var category in Categories)
            {
                var accent = AccentClass(category.DisplayOrder);
                var statusClass = category.IsEnabled ? "enabled" : "disabled";
                <article class="category-admin-card @accent" data-status="@statusClass" data-search-item="@($"{category.DisplayName} {category.Slug} {category.Summary}")">
                    <div class="category-admin-card-top">
                        <span class="category-admin-icon"><i class="bi bi-bookmark-star-fill" aria-hidden="true"></i></span>
                        <span class="category-admin-status @statusClass"><i aria-hidden="true"></i>@(category.IsEnabled ? "Đang công khai" : "Đang ẩn")</span>
                    </div>
                    <h3>@category.DisplayName</h3>
                    <span class="category-admin-slug">/bai-viet/@category.Slug</span>
                    <p>@category.Summary</p>
                    <div class="category-admin-card-meta">
                        <span>@category.ArticleCount bài viết</span>
                        <span>Thứ tự @category.DisplayOrder</span>
                    </div>
                    <div class="category-admin-card-actions">
                        <button class="category-action-edit" type="button" @onclick="() => OpenEditModal(category)"><i class="bi bi-pencil-square" aria-hidden="true"></i> Chỉnh sửa</button>
                        <button class="category-action-toggle" type="button" disabled="@IsProcessing" @onclick="() => ToggleCategoryAsync(category)" title="@(category.IsEnabled ? "Ẩn chuyên mục" : "Hiển thị chuyên mục")"><i class="bi @(category.IsEnabled ? "bi-eye-slash" : "bi-eye")" aria-hidden="true"></i><span>@(category.IsEnabled ? "Ẩn" : "Hiển thị")</span></button>
                        @if (category.ArticleCount == 0)
                        {
                            <button class="category-action-delete" type="button" disabled="@IsProcessing" @onclick="() => DeleteCategoryAsync(category)" title="Xóa chuyên mục"><i class="bi bi-trash3" aria-hidden="true"></i><span>Xóa</span></button>
                        }
                        else
                        {
                            <span class="category-delete-unavailable" title="Chuyên mục cần không còn bài viết mới được xóa"><i class="bi bi-shield-lock" aria-hidden="true"></i><span>Đang dùng</span></span>
                        }
                    </div>
                </article>
            }
        </div>
    }
</section>

@code {
    [SupplyParameterFromQuery(Name = "status")] public string? Status { get; set; }
    [SupplyParameterFromQuery(Name = "error")] public string? Error { get; set; }
    [SupplyParameterFromQuery(Name = "edit")] public Guid? EditId { get; set; }
    [SupplyParameterFromQuery(Name = "create")] public string? Create { get; set; }

    private IReadOnlyList<ArticleCategoryAdminSummary> Categories { get; set; } = [];
    private bool ShowForm => EditId.HasValue || Create == "true";
    private string? LoadError { get; set; }
    private string? SuccessNotice { get; set; }
    private string? ErrorNotice { get; set; }
    private string? ModalError { get; set; }
    private bool IsProcessing { get; set; }

    private string FormSlug { get; set; } = string.Empty;
    private string FormDisplayName { get; set; } = string.Empty;
    private string FormSummary { get; set; } = string.Empty;
    private string FormDisplayOrder { get; set; } = "0";
    private bool FormIsEnabled { get; set; } = true;

    protected override async Task OnParametersSetAsync()
    {
        Categories = await ArticlesService.GetCategorySnapshotAsync();
        LoadError = null;
        if (!EditId.HasValue)
        {
            if (Create == "true")
            {
                await OpenCreateModal();
            }
            return;
        }

        var category = Categories.FirstOrDefault(x => x.Id == EditId.Value);
        if (category is null)
        {
            LoadError = "Không tìm thấy chuyên mục cần chỉnh sửa.";
            return;
        }

        await OpenEditModal(category);
    }

    private async Task OpenCreateModal()
    {
        EditId = null;
        FormSlug = string.Empty;
        FormDisplayName = string.Empty;
        FormSummary = string.Empty;
        FormDisplayOrder = ((Categories.Count == 0 ? 0 : Categories.Max(x => x.DisplayOrder)) + 1).ToString();
        FormIsEnabled = true;
        ModalError = null;
        await JS.InvokeVoidAsync("eval", "document.querySelector('[data-category-modal]')?.showModal()");
    }

    private async Task OpenEditModal(ArticleCategoryAdminSummary category)
    {
        EditId = category.Id;
        FormSlug = category.Slug;
        FormDisplayName = category.DisplayName;
        FormSummary = category.Summary;
        FormDisplayOrder = category.DisplayOrder.ToString();
        FormIsEnabled = category.IsEnabled;
        ModalError = null;
        await JS.InvokeVoidAsync("eval", "document.querySelector('[data-category-modal]')?.showModal()");
    }

    private async Task CloseModal()
    {
        EditId = null;
        ModalError = null;
        await JS.InvokeVoidAsync("eval", "document.querySelector('[data-category-modal]')?.close()");
    }

    private async Task SaveCategoryAsync()
    {
        if (IsProcessing) return;
        IsProcessing = true;
        ModalError = null;
        try
        {
            var authState = await AuthStateProvider.GetAuthenticationStateAsync();
            var actor = authState.User.Identity?.Name ?? "unknown";
            var request = new SaveArticleCategoryRequest(
                EditId,
                FormSlug,
                FormDisplayName,
                FormSummary,
                int.TryParse(FormDisplayOrder, out var order) ? order : 0,
                FormIsEnabled);

            await ArticlesService.SaveCategoryAsync(request, actor);
            Categories = await ArticlesService.GetCategorySnapshotAsync();
            SuccessNotice = EditId.HasValue ? "Đã cập nhật chuyên mục." : "Đã tạo chuyên mục.";
            ErrorNotice = null;
            await CloseModal();
        }
        catch (Exception ex)
        {
            ModalError = ex.Message;
        }
        finally
        {
            IsProcessing = false;
        }
    }

    private async Task ToggleCategoryAsync(ArticleCategoryAdminSummary category)
    {
        if (IsProcessing) return;
        var confirmed = await JS.InvokeAsync<bool>("confirm", "Thay đổi trạng thái hiển thị chuyên mục này?");
        if (!confirmed) return;

        IsProcessing = true;
        try
        {
            var authState = await AuthStateProvider.GetAuthenticationStateAsync();
            var actor = authState.User.Identity?.Name ?? "unknown";
            await ArticlesService.SetCategoryEnabledAsync(category.Id, !category.IsEnabled, actor);
            Categories = await ArticlesService.GetCategorySnapshotAsync();
            SuccessNotice = !category.IsEnabled ? "Chuyên mục đã được hiển thị công khai." : "Chuyên mục đã được ẩn khỏi website công khai.";
            ErrorNotice = null;
        }
        catch (Exception ex)
        {
            ErrorNotice = ex.Message;
            SuccessNotice = null;
        }
        finally
        {
            IsProcessing = false;
        }
    }

    private async Task DeleteCategoryAsync(ArticleCategoryAdminSummary category)
    {
        if (IsProcessing) return;
        var confirmed = await JS.InvokeAsync<bool>("confirm", "Xóa vĩnh viễn chuyên mục này? Thao tác này không thể hoàn tác.");
        if (!confirmed) return;

        IsProcessing = true;
        try
        {
            var authState = await AuthStateProvider.GetAuthenticationStateAsync();
            var actor = authState.User.Identity?.Name ?? "unknown";
            await ArticlesService.DeleteCategoryAsync(category.Id, actor);
            Categories = await ArticlesService.GetCategorySnapshotAsync();
            SuccessNotice = "Đã xóa chuyên mục.";
            ErrorNotice = null;
        }
        catch (Exception ex)
        {
            ErrorNotice = ex.Message;
            SuccessNotice = null;
        }
        finally
        {
            IsProcessing = false;
        }
    }

    private static string AccentClass(int order) => (Math.Abs(order) % 5) switch
    {
        0 => "accent-orange",
        1 => "accent-blue",
        2 => "accent-purple",
        3 => "accent-green",
        _ => "accent-red"
    };
}
