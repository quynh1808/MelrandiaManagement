@page "/Management/Tasks"
@attribute [Authorize(Policy = "ManagePortal")]
@layout ManagementLayout
@inject PortalAdministrationService Administration

<PageTitle>Nhiệm vụ · Melrandia</PageTitle>

<section class="management-page-heading compact"><div><h1>Nhiệm vụ</h1><p>Các việc cấu hình được suy ra trực tiếp từ trạng thái Project Registry.</p></div><span class="management-readonly-badge">Read-only checklist</span></section>

<section class="management-kpi-grid">
    <article><span class="kpi-icon blue">☑</span><div><small>Tổng nhiệm vụ</small><strong>@Tasks.Count</strong><em>Checklist tự động</em></div></article>
    <article><span class="kpi-icon orange">◴</span><div><small>Cần thực hiện</small><strong>@Tasks.Count(x => x.State != "Done")</strong><em>Chưa hoàn tất</em></div></article>
    <article><span class="kpi-icon green">✓</span><div><small>Hoàn thành</small><strong>@Tasks.Count(x => x.State == "Done")</strong><em>Đã đủ cấu hình</em></div></article>
    <article><span class="kpi-icon violet">▱</span><div><small>Dự án liên quan</small><strong>@Projects.Count</strong><em>Phạm vi hiện tại</em></div></article>
</section>

<div class="task-board">
    @foreach (var column in Columns)
    {
        <section class="management-panel task-column"><header><h2><i class="@column.Class"></i>@column.Label</h2><span>@Tasks.Count(x => x.State == column.State)</span></header><div class="task-list">
            @foreach (var task in Tasks.Where(x => x.State == column.State))
            {
                <article data-search-item="@($"{task.Title} {task.Project}")"><span class="task-type-icon">@task.Icon</span><h3>@task.Title</h3><p>@task.Project</p><small>@task.Detail</small><a href="/Management/Projects">Mở Project Registry →</a></article>
            }
            @if (!Tasks.Any(x => x.State == column.State)) { <p class="management-empty">Không có nhiệm vụ.</p> }
        </div></section>
    }
</div>

<section class="management-info-banner"><span>ⓘ</span><div><strong>Phạm vi phiên bản hiện tại</strong><p>Trang này là checklist vận hành tự sinh, chưa phải module giao việc có người phụ trách và deadline. Thiết kế đã tách sẵn để bổ sung workflow lưu PostgreSQL về sau.</p></div></section>

@code {
    private IReadOnlyList<ManagementProjectCard> Projects { get; set; } = [];
    private List<SetupTask> Tasks { get; set; } = [];
    private static readonly (string State, string Label, string Class)[] Columns = [("Backlog", "Backlog", "gray"), ("InProgress", "Đang thực hiện", "orange"), ("Done", "Hoàn thành", "green")];
    protected override async Task OnInitializedAsync() { Projects = await Administration.GetProjectsAsync(); Tasks = BuildTasks(Projects); }
    private static List<SetupTask> BuildTasks(IEnumerable<ManagementProjectCard> projects) { var result = new List<SetupTask>(); foreach (var p in projects) { result.Add(new("Public URL", p.DisplayName, string.IsNullOrWhiteSpace(p.PublicUrl) ? "Backlog" : "Done", "Định nghĩa địa chỉ truy cập project.", "↗")); result.Add(new("Health endpoint", p.DisplayName, string.IsNullOrWhiteSpace(p.HealthUrl) ? "Backlog" : p.HealthStatus == "Healthy" ? "Done" : "InProgress", "Cấu hình và xác minh readiness endpoint.", "♡")); result.Add(new("Quyền người dùng", p.DisplayName, p.GrantedUserCount > 0 ? "Done" : "Backlog", "Cấp ít nhất một quyền project cho tài khoản.", "♙")); } return result; }
    private sealed record SetupTask(string Title, string Project, string State, string Detail, string Icon);
}
