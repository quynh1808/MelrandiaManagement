@page "/Management/Articles"
@attribute [Authorize(Policy = "ManagePortal")]
@layout ManagementLayout
@inject ArticleAdministrationService ArticlesService
@inject AuthenticationStateProvider AuthStateProvider
@inject IJSRuntime JS
@inject NavigationManager Navigation
@using System.Security.Claims

<PageTitle>Bài viết · Melrandia</PageTitle>

<section class="management-page-heading compact article-page-heading">
    <div><h1>Bài viết của tôi</h1><p>Quản lý, chỉnh sửa và theo dõi hiệu suất các bài viết blog.</p></div>
    <a class="management-primary-action" href="/Management/Articles/New"><i class="bi bi-pencil-square" aria-hidden="true"></i> Soạn bài viết mới</a>
</section>
@if (!string.IsNullOrWhiteSpace(SuccessNotice)) { <div class="form-notice success">@SuccessNotice</div> }
else if (Status == "deleted") { <div class="form-notice success">Đã xóa bài viết.</div> }
else if (Status == "duplicated") { <div class="form-notice success">Đã tạo bản nháp sao chép.</div> }
else if (Status == "saved") { <div class="form-notice success">Đã lưu bài viết và cập nhật Public Article Catalog.</div> }
@if (!string.IsNullOrWhiteSpace(ErrorNotice)) { <div class="form-notice error">@ErrorNotice</div> }
else if (!string.IsNullOrWhiteSpace(Error)) { <div class="form-notice error">@Error</div> }

<section class="management-kpi-grid">
    <article><span class="kpi-icon blue"><img src="/images/Managements/TotalArticles.svg" alt="" aria-hidden="true" /></span><div><small>Tổng bài viết</small><strong>@Snapshot.Articles.Count</strong><em>PostgreSQL</em></div></article>
    <article><span class="kpi-icon green"><img src="/images/Managements/Published.svg" alt="" aria-hidden="true" /></span><div><small>Published</small><strong>@Count(PortalArticleStatuses.Published)</strong><em>Đang công khai</em></div></article>
    <article><span class="kpi-icon orange"><img src="/images/Managements/DraftScheduled.svg" alt="" aria-hidden="true" /></span><div><small>Draft &amp; Scheduled</small><strong>@DraftAndScheduled</strong><em>Chưa công khai</em></div></article>
    <article><span class="kpi-icon violet"><img src="/images/Managements/Images.svg" alt="" aria-hidden="true" /></span><div><small>Hình ảnh</small><strong>@Snapshot.Articles.Sum(x => x.MediaCount)</strong><em>Persistent volume</em></div></article>
</section>

<section class="management-panel article-registry-panel">
    <div class="article-filter-bar" role="group" aria-label="Lọc bài viết">
        <div class="article-filter-tabs" role="group" aria-label="Lọc theo trạng thái">
            <button type="button" class="article-filter-tab active" data-article-filter-tab="all" aria-pressed="true">Tất cả <span>@Snapshot.Articles.Count</span></button>
            <button type="button" class="article-filter-tab" data-article-filter-tab="published" aria-pressed="false">Công khai <span>@Count(PortalArticleStatuses.Published)</span></button>
            <button type="button" class="article-filter-tab" data-article-filter-tab="draft" aria-pressed="false">Bản nháp <span>@Count(PortalArticleStatuses.Draft)</span></button>
            <button type="button" class="article-filter-tab" data-article-filter-tab="scheduled" aria-pressed="false">Lên lịch <span>@Count(PortalArticleStatuses.Scheduled)</span></button>
        </div>
        <label class="article-filter-search">
            <i class="bi bi-search" aria-hidden="true"></i>
            <input type="search" placeholder="Tìm theo tiêu đề, danh mục..." aria-label="Tìm bài viết theo tiêu đề hoặc chuyên mục" data-management-article-search />
        </label>
    </div>
    <div class="management-table-wrap">
        <table class="management-table article-management-table">
            <thead><tr><th>Bài viết</th><th>Chuyên mục</th><th>Trạng thái</th><th>Ảnh</th><th>Ngày cập nhật</th><th class="text-end">Thao tác</th></tr></thead>
            <tbody>
                @foreach (var article in Snapshot.Articles)
                {
                    var statusClass = article.Status.ToLowerInvariant();
                    <tr data-article-row data-status="@statusClass" data-search-item="@($"{article.Title} {article.Slug} {article.CategoryName}")">
                        <td>
                            <a class="article-table-identity" href="@($"/Management/Articles/Edit/{article.Id}")">
                                @if (!string.IsNullOrWhiteSpace(article.CoverUrl))
                                {
                                    <img src="@article.CoverUrl" alt="" loading="lazy" />
                                }
                                else
                                {
                                    <span class="article-admin-placeholder">✎</span>
                                }
                                <span><strong>@article.Title</strong><small>/bai-viet/@article.Slug</small></span>
                            </a>
                        </td>
                        <td>@article.CategoryName</td>
                        <td><span class="article-status @statusClass">@StatusLabel(article.Status)</span></td>
                        <td>@article.MediaCount</td>
                        <td>@article.UpdatedAtUtc.ToLocalTime().ToString("dd/MM/yyyy HH:mm")</td>
                        <td class="text-end">
                            <div class="article-row-actions">
                                <a class="article-icon-action preview" href="@($"/Management/Articles/Preview/{article.Id}")" title="Xem trước" aria-label="Xem trước"><span class="material-symbols-outlined" aria-hidden="true">visibility</span></a>
                                <a class="article-icon-action edit" href="@($"/Management/Articles/Edit/{article.Id}")" title="Chỉnh sửa bài viết" aria-label="Chỉnh sửa"><span class="material-symbols-outlined" aria-hidden="true">edit</span></a>
                                <button class="article-icon-action duplicate" type="button" title="Nhân bản bài viết" aria-label="Nhân bản" disabled="@IsProcessing" @onclick="() => DuplicateAsync(article.Id)"><span class="material-symbols-outlined" aria-hidden="true">content_copy</span></button>
                                <button class="article-icon-action delete" type="button" title="Xóa bài viết" aria-label="Xóa bài viết" disabled="@IsProcessing" @onclick="() => DeleteAsync(article.Id, article.Title)"><span class="material-symbols-outlined" aria-hidden="true">delete</span></button>
                            </div>
                        </td>
                    </tr>
                }
                @if (Snapshot.Articles.Count == 0)
                {
                    <tr><td colspan="6"><div class="management-empty-state compact"><span>✎</span><h3>Chưa có bài viết</h3><p>Dùng trang Thêm bài viết để tạo bản nháp đầu tiên.</p></div></td></tr>
                }
            </tbody>
        </table>
    </div>
</section>

@code {
    [SupplyParameterFromQuery(Name = "status")] public string? Status { get; set; }
    [SupplyParameterFromQuery(Name = "error")] public string? Error { get; set; }
    private string? SuccessNotice { get; set; }
    private string? ErrorNotice { get; set; }
    private bool IsProcessing { get; set; }
    private ArticleAdminSnapshot Snapshot { get; set; } = new([], []);
    private int DraftAndScheduled => Count(PortalArticleStatuses.Draft) + Count(PortalArticleStatuses.Scheduled);
    private int Count(string status) => Snapshot.Articles.Count(x => x.Status == status);
    private static string StatusLabel(string status) => status switch
    {
        PortalArticleStatuses.Published => "Công khai",
        PortalArticleStatuses.Draft => "Bản nháp",
        PortalArticleStatuses.Scheduled => "Đã lên lịch",
        PortalArticleStatuses.Archived => "Lưu trữ",
        _ => status
    };

    protected override async Task OnInitializedAsync() => Snapshot = await ArticlesService.GetSnapshotAsync();

    private async Task DuplicateAsync(Guid id)
    {
        if (IsProcessing) return;
        IsProcessing = true;
        try
        {
            var authState = await AuthStateProvider.GetAuthenticationStateAsync();
            var user = authState.User;
            if (!Guid.TryParse(user.FindFirstValue(ClaimTypes.NameIdentifier), out var authorId))
            {
                ErrorNotice = "Không xác định được danh tính người dùng.";
                return;
            }
            var actor = user.Identity?.Name ?? "unknown";
            var duplicateId = await ArticlesService.DuplicateAsync(id, authorId, actor);
            Snapshot = await ArticlesService.GetSnapshotAsync();
            SuccessNotice = "Đã tạo bản nháp sao chép.";
            ErrorNotice = null;
        }
        catch (Exception ex)
        {
            ErrorNotice = ex.Message;
            SuccessNotice = null;
        }
        finally
        {
            IsProcessing = false;
        }
    }

    private async Task DeleteAsync(Guid id, string title)
    {
        if (IsProcessing) return;
        var confirmed = await JS.InvokeAsync<bool>("confirm", $"Bạn có chắc chắn muốn xóa bài viết \"{title}\"? Thao tác này không thể hoàn tác.");
        if (!confirmed) return;

        IsProcessing = true;
        try
        {
            var authState = await AuthStateProvider.GetAuthenticationStateAsync();
            var actor = authState.User.Identity?.Name ?? "unknown";
            await ArticlesService.DeleteAsync(id, actor);
            Snapshot = await ArticlesService.GetSnapshotAsync();
            SuccessNotice = "Đã xóa bài viết.";
            ErrorNotice = null;
        }
        catch (Exception ex)
        {
            ErrorNotice = ex.Message;
            SuccessNotice = null;
        }
        finally
        {
            IsProcessing = false;
        }
    }
}
