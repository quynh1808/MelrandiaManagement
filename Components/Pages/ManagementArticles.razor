@page "/Management/Articles"
@attribute [Authorize(Policy = "ManagePortal")]
@layout ManagementLayout
@inject ArticleAdministrationService ArticlesService

<PageTitle>Bài viết · Melrandia</PageTitle>

<section class="management-page-heading compact"><div><h1>Bài viết</h1><p>Soạn thảo, xuất bản và quản lý hình ảnh của nội dung công khai.</p></div><a class="management-primary-action" href="#new-article">＋ Thêm bài viết</a></section>
@if (!string.IsNullOrWhiteSpace(Status)) { <div class="form-notice success">Đã lưu bài viết và cập nhật Public Article Catalog.</div> }
@if (!string.IsNullOrWhiteSpace(Error)) { <div class="form-notice error">@Error</div> }

<section class="management-kpi-grid">
    <article><span class="kpi-icon blue">✎</span><div><small>Tổng bài viết</small><strong>@Snapshot.Articles.Count</strong><em>PostgreSQL</em></div></article>
    <article><span class="kpi-icon green">✓</span><div><small>Published</small><strong>@Count(PortalArticleStatuses.Published)</strong><em>Đang công khai</em></div></article>
    <article><span class="kpi-icon orange">◴</span><div><small>Draft &amp; Scheduled</small><strong>@DraftAndScheduled</strong><em>Chưa công khai</em></div></article>
    <article><span class="kpi-icon violet">▣</span><div><small>Hình ảnh</small><strong>@Snapshot.Articles.Sum(x => x.MediaCount)</strong><em>Persistent volume</em></div></article>
</section>

<section id="new-article" class="article-editor-layout">
    <form class="management-panel article-editor-form portal-form" method="post" action="/management/articles/save" enctype="multipart/form-data" onsubmit="return confirm('Bạn có chắc chắn muốn lưu bài viết với trạng thái đã chọn?');">
        <AntiforgeryToken /><input type="hidden" name="version" value="1" />
        <header><div><h2>Thêm bài viết</h2><p>Nội dung gốc dùng Markdown; HTML nhập trực tiếp sẽ không được thực thi.</p></div></header>
        <div class="article-editor-fields">
            <label><span>Tiêu đề</span><input name="title" data-article-title minlength="5" maxlength="240" placeholder="Nhập tiêu đề bài viết" required /></label>
            <div class="form-grid two"><label><span>Slug</span><input name="slug" data-article-slug pattern="[a-z0-9-]+" maxlength="160" placeholder="tu-dong-tao-tu-tieu-de" required /></label><label><span>Chuyên mục</span><select name="categoryId" required>@foreach (var category in Snapshot.Categories){<option value="@category.Id">@category.DisplayName</option>}</select></label></div>
            <label><span>Mô tả ngắn</span><textarea name="summary" minlength="20" maxlength="700" rows="3" required></textarea></label>
            <label><span>Nội dung Markdown</span><textarea class="markdown-editor" name="contentMarkdown" minlength="50" maxlength="200000" rows="18" placeholder="# Tiêu đề mục&#10;&#10;Nội dung bài viết..." required></textarea><small class="field-help">Hỗ trợ heading, danh sách, bảng, trích dẫn, liên kết HTTP/HTTPS và code block. Raw HTML bị vô hiệu hóa.</small></label>
        </div>
        <aside class="article-publish-panel">
            <label><span>Trạng thái</span><select name="status"><option value="Draft">Draft</option><option value="Published">Published</option><option value="Scheduled">Scheduled</option><option value="Archived">Archived</option></select></label>
            <label><span>Xuất bản/Hẹn giờ UTC</span><input name="publishedAtUtc" type="datetime-local" /><small class="field-help">Bắt buộc khi chọn Scheduled.</small></label>
            <label><span>Ảnh đại diện</span><input name="cover" type="file" accept="image/jpeg,image/png,image/gif,image/webp" /></label>
            <label><span>Alt text ảnh đại diện</span><input name="coverAlt" maxlength="300" placeholder="Mô tả nội dung hình ảnh" /></label>
            <label><span>Gallery</span><input name="gallery" type="file" accept="image/jpeg,image/png,image/gif,image/webp" multiple /><small class="field-help">JPEG, PNG, GIF, WebP; tối đa theo cấu hình server.</small></label>
            <button class="management-primary-action" type="submit">Lưu bài viết</button>
        </aside>
    </form>
</section>

<section class="management-panel article-registry-panel"><header class="panel-toolbar"><div><h2>Thư viện bài viết</h2><p>Chỉnh sửa sẽ tăng Version để phát hiện hai phiên ghi đè nhau.</p></div><label class="compact-select"><select data-management-status-filter aria-label="Lọc trạng thái"><option value="all">All status</option><option value="published">Published</option><option value="draft">Draft</option><option value="scheduled">Scheduled</option><option value="archived">Archived</option></select></label></header>
    <div class="article-admin-list">
        @foreach (var article in Snapshot.Articles)
        {
            <details id="article-@article.Id" data-status="@article.Status.ToLowerInvariant()" data-search-item="@($"{article.Title} {article.Slug} {article.CategoryName}")">
                <summary>@if (!string.IsNullOrWhiteSpace(article.CoverUrl)){<img src="@article.CoverUrl" alt="" loading="lazy" />}else{<span class="article-admin-placeholder">✎</span>}<span><strong>@article.Title</strong><small>@article.CategoryName · @article.AuthorName · cập nhật @article.UpdatedAtUtc.ToLocalTime().ToString("dd/MM/yyyy HH:mm")</small></span><span class="article-status @article.Status.ToLowerInvariant()">@article.Status</span><b>@article.MediaCount ảnh</b></summary>
                <EditArticleForm ArticleId="article.Id" Categories="Snapshot.Categories" />
            </details>
        }
        @if (Snapshot.Articles.Count == 0) { <div class="management-empty-state compact"><span>✎</span><h3>Chưa có bài viết</h3><p>Dùng form phía trên để tạo bản nháp đầu tiên.</p></div> }
    </div>
</section>

@code {
    [SupplyParameterFromQuery(Name = "status")] public string? Status { get; set; }
    [SupplyParameterFromQuery(Name = "error")] public string? Error { get; set; }
    private ArticleAdminSnapshot Snapshot { get; set; } = new([], []);
    private int DraftAndScheduled => Count(PortalArticleStatuses.Draft) + Count(PortalArticleStatuses.Scheduled);
    private int Count(string status) => Snapshot.Articles.Count(x => x.Status == status);
    protected override async Task OnInitializedAsync() => Snapshot = await ArticlesService.GetSnapshotAsync();
}
