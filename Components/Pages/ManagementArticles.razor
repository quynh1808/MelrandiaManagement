@page "/Management/Articles"
@attribute [Authorize(Policy = "ManagePortal")]
@layout ManagementLayout
@inject ArticleAdministrationService ArticlesService

<PageTitle>Bài viết · Melrandia</PageTitle>

<section class="management-page-heading compact"><div><h1>Bài viết</h1><p>Soạn thảo, xuất bản và quản lý hình ảnh của nội dung công khai.</p></div><a class="management-primary-action" href="/Management/Articles/New">＋ Thêm bài viết</a></section>
@if (Status == "deleted") { <div class="form-notice success">Đã xóa bài viết.</div> }
else if (Status == "duplicated") { <div class="form-notice success">Đã tạo bản nháp sao chép.</div> }
else if (Status == "saved") { <div class="form-notice success">Đã lưu bài viết và cập nhật Public Article Catalog.</div> }
@if (!string.IsNullOrWhiteSpace(Error)) { <div class="form-notice error">@Error</div> }

<section class="management-kpi-grid">
    <article><span class="kpi-icon blue">✎</span><div><small>Tổng bài viết</small><strong>@Snapshot.Articles.Count</strong><em>PostgreSQL</em></div></article>
    <article><span class="kpi-icon green">✓</span><div><small>Published</small><strong>@Count(PortalArticleStatuses.Published)</strong><em>Đang công khai</em></div></article>
    <article><span class="kpi-icon orange">◴</span><div><small>Draft &amp; Scheduled</small><strong>@DraftAndScheduled</strong><em>Chưa công khai</em></div></article>
    <article><span class="kpi-icon violet">▣</span><div><small>Hình ảnh</small><strong>@Snapshot.Articles.Sum(x => x.MediaCount)</strong><em>Persistent volume</em></div></article>
</section>

<section class="management-panel article-registry-panel">
    <header class="panel-toolbar">
        <div><h2>Bài viết của tôi</h2><p>Quản lý, chỉnh sửa và theo dõi hiệu suất các bài viết blog.</p></div>
        <label class="compact-select"><select data-management-status-filter aria-label="Lọc trạng thái"><option value="all">Tất cả trạng thái</option><option value="published">Công khai</option><option value="draft">Bản nháp</option><option value="scheduled">Đã lên lịch</option><option value="archived">Lưu trữ</option></select></label>
    </header>
    <div class="management-table-wrap">
        <table class="management-table article-management-table">
            <thead><tr><th>Bài viết</th><th>Chuyên mục</th><th>Trạng thái</th><th>Ảnh</th><th>Ngày cập nhật</th><th class="text-end">Thao tác</th></tr></thead>
            <tbody>
                @foreach (var article in Snapshot.Articles)
                {
                    var statusClass = article.Status.ToLowerInvariant();
                    <tr data-status="@statusClass" data-search-item="@($"{article.Title} {article.Slug} {article.CategoryName}")">
                        <td>
                            <a class="article-table-identity" href="@($"/Management/Articles/Edit/{article.Id}")">
                                @if (!string.IsNullOrWhiteSpace(article.CoverUrl))
                                {
                                    <img src="@article.CoverUrl" alt="" loading="lazy" />
                                }
                                else
                                {
                                    <span class="article-admin-placeholder">✎</span>
                                }
                                <span><strong>@article.Title</strong><small>/bai-viet/@article.Slug</small></span>
                            </a>
                        </td>
                        <td>@article.CategoryName</td>
                        <td><span class="article-status @statusClass">@StatusLabel(article.Status)</span></td>
                        <td>@article.MediaCount</td>
                        <td>@article.UpdatedAtUtc.ToLocalTime().ToString("dd/MM/yyyy HH:mm")</td>
                        <td class="text-end">
                            <div class="article-row-actions">
                                <a class="article-icon-action" href="@($"/Management/Articles/Preview/{article.Id}")" title="Xem trước" aria-label="Xem trước"><i class="bi bi-eye"></i></a>
                                <a class="article-icon-action edit" href="@($"/Management/Articles/Edit/{article.Id}")" title="Chỉnh sửa bài viết" aria-label="Chỉnh sửa"><i class="bi bi-pencil-square"></i></a>
                                <form method="post" action="/management/articles/duplicate">
                                    <AntiforgeryToken />
                                    <input type="hidden" name="articleId" value="@article.Id" />
                                    <button class="article-icon-action" type="submit" title="Nhân bản bài viết" aria-label="Nhân bản"><i class="bi bi-copy"></i></button>
                                </form>
                                <form method="post" action="/management/articles/delete" onsubmit="return confirm('Bạn có chắc chắn muốn xóa bài viết &quot;@article.Title&quot;? Thao tác này không thể hoàn tác.');">
                                    <AntiforgeryToken />
                                    <input type="hidden" name="articleId" value="@article.Id" />
                                    <button class="article-icon-action delete" type="submit" title="Xóa bài viết" aria-label="Xóa bài viết"><i class="bi bi-trash3"></i></button>
                                </form>
                            </div>
                        </td>
                    </tr>
                }
                @if (Snapshot.Articles.Count == 0)
                {
                    <tr><td colspan="6"><div class="management-empty-state compact"><span>✎</span><h3>Chưa có bài viết</h3><p>Dùng trang Thêm bài viết để tạo bản nháp đầu tiên.</p></div></td></tr>
                }
            </tbody>
        </table>
    </div>
</section>

@code {
    [SupplyParameterFromQuery(Name = "status")] public string? Status { get; set; }
    [SupplyParameterFromQuery(Name = "error")] public string? Error { get; set; }
    private ArticleAdminSnapshot Snapshot { get; set; } = new([], []);
    private int DraftAndScheduled => Count(PortalArticleStatuses.Draft) + Count(PortalArticleStatuses.Scheduled);
    private int Count(string status) => Snapshot.Articles.Count(x => x.Status == status);
    private static string StatusLabel(string status) => status switch
    {
        PortalArticleStatuses.Published => "Công khai",
        PortalArticleStatuses.Draft => "Bản nháp",
        PortalArticleStatuses.Scheduled => "Đã lên lịch",
        PortalArticleStatuses.Archived => "Lưu trữ",
        _ => status
    };
    protected override async Task OnInitializedAsync() => Snapshot = await ArticlesService.GetSnapshotAsync();
}
