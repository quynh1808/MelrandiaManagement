# Immutable image produced by .github/workflows/verify-and-publish.yml.
MM_IMAGE=ghcr.io/quynh1808/melrandia-management
MM_VERSION=sha-replace-with-commit-sha

# Bind to 127.0.0.1 for same-machine testing. On an isolated LAN, replace it
# with the Ubuntu server's static IPv4 address, for example 192.168.100.66.
MM_BIND_ADDRESS=127.0.0.1
MM_HTTP_PORT=8090

# MM owns this PostgreSQL database. Never reuse the AMS application database.
MM_POSTGRES_DATABASE=melrandia_management
MM_POSTGRES_USERNAME=melrandia_app
MM_POSTGRES_PASSWORD=replace-with-a-long-random-database-password

# Used only if the database has no Administrator yet. Changing this value later
# does not reset an existing account password.
MM_BOOTSTRAP_ADMIN_USERNAME=admin
MM_BOOTSTRAP_ADMIN_PASSWORD=replace-with-a-strong-admin-password
MM_BOOTSTRAP_ADMIN_DISPLAY_NAME="Quản trị Melrandia"

# Public URL is opened by the browser; health URL is called by the MM container.
# Do not use localhost here when AMS runs in another container.
MM_AMS_PUBLIC_URL=http://192.168.100.66:8080
MM_AMS_HEALTH_URL=http://192.168.100.66:8080/health/ready

# Short process-local cache for public project metadata. Administrator updates
# invalidate it immediately on the current MM instance.
MM_PUBLIC_PROJECT_CACHE_SECONDS=30

# Article bytes live in a persistent Docker volume; PostgreSQL stores only metadata.
MM_ARTICLE_MAX_FILE_MB=8
MM_ARTICLE_MAX_FILES=8
