{
  "PostgreSql": {
    "Host": "127.0.0.1",
    "Port": 5432,
    "DatabaseName": "melrandia_management",
    "Username": "melrandia_app",
    "Password": "",
    "CommandTimeoutSeconds": 30,
    "AutoMigrate": true
  },
  "BootstrapAdmin": {
    "Username": "admin",
    "Password": "",
    "DisplayName": "Quản trị Melrandia"
  },
  "InitialProjects": {
    "AmsPublicUrl": "http://localhost:5080",
    "AmsHealthUrl": "http://localhost:5080/health/ready",
    "HealthCheckIntervalSeconds": 30,
    "HealthCheckTimeoutSeconds": 5
  },
  "PortalPerformance": {
    "PublicProjectCacheSeconds": 30
  },
  "ArticleMedia": {
    "RootPath": "App_Data/media",
    "MaxFileSizeMegabytes": 8,
    "MaxFilesPerArticle": 8
  },
  "Logging": {
    "LogLevel": {
      "Default": "Information",
      "Microsoft.AspNetCore": "Warning",
      "Microsoft.EntityFrameworkCore.Database.Command": "Warning",
      "System.Net.Http.HttpClient.project-health": "Warning"
    }
  },
  "AllowedHosts": "*"
}
